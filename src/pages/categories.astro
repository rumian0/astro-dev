---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";

const [blogPosts, galleryPosts] = await Promise.all([
  getCollection("blog"),
  SITE.showGalleries && SITE.showGalleriesInIndex
    ? getCollection("galleries")
    : Promise.resolve([]),
]);
const posts = getSortedPosts([...blogPosts, ...galleryPosts]);

// 按分类分组（categories 数组取第一个；无分类归入「其他」）
const categoriesMap = new Map<string, typeof posts>();
for (const post of posts) {
  const cats = (post.data as { categories?: string[] }).categories;
  const cat = (cats && cats.length ? cats[0] : "其他") as string;
  if (!categoriesMap.has(cat)) categoriesMap.set(cat, []);
  categoriesMap.get(cat)!.push(post);
}
const categories = [...categoriesMap.entries()].sort(
  (a, b) => b[1].length - a[1].length
);
const totalCount = posts.length;
---

<Layout title={`分类 | ${SITE.title}`} description="按分类浏览全部文章">
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-12">
    <!-- Hero -->
    <div class="archive-hero" data-archive-hero>
      <div class="aurora-orb aurora-orb-1"></div>
      <div class="aurora-orb aurora-orb-2"></div>
      <div class="aurora-orb aurora-orb-3"></div>
      <div class="aurora-mouse" data-archive-mouse></div>
      <div class="relative z-10">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          <span class="glow-text">Categories</span>
        </h1>
        <p class="mt-3 max-w-lg text-foreground/70 italic">
          按分类浏览全部文章。
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <span class="hero-badge">{categories.length} 个分类</span>
          <span class="hero-badge">{totalCount} 篇文章</span>
        </div>
      </div>
    </div>

    <!-- ═══ 分类卡片墙（仿清羽 categories）═══ -->
    <div class="cat-grid mt-10">
      {categories.map(([cat, list]) => {
        const anchor = `cat-${slugifyStr(cat)}`;
        return (
          <a
            href={`#${anchor}`}
            class="cat-card group"
            data-cat-card
          >
            <div class="cat-aurora" data-cat-aurora />
            <div class="cat-content">
              <div class="flex items-center gap-2">
                <span class="cat-name">{cat}</span>
              </div>
              <div class="cat-count">
                <span class="cat-count-number">{list.length}</span>
                <span class="cat-count-label">
                  {list.length === 1 ? "post" : "posts"}
                </span>
              </div>
            </div>
            <div class="cat-orbit" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
          </a>
        );
      })}
    </div>

    <!-- ═══ 各分类文章列表 ═══ -->
    {categories.map(([cat, list]) => {
      const anchor = `cat-${slugifyStr(cat)}`;
      return (
        <section id={anchor} class="cat-section mt-14 scroll-mt-28">
          <h2 class="mb-5 flex items-baseline gap-3">
            <span class="text-xl font-bold tracking-tight text-foreground">
              {cat}
            </span>
            <span class="font-firacode text-xs text-foreground/40">
              {list.length}
            </span>
            <span class="h-px flex-1 bg-border/20" />
            <a
              href={`#${anchor}`}
              class="font-firacode text-xs text-accent/50 hover:text-accent"
              aria-label={`${cat} 锚点`}
            >
              #
            </a>
          </h2>
          <ul class="space-y-1">
            {list.map((data, index) => (
              <Card
                variant="h3"
                {...data}
                loading={index < 2 ? "eager" : "lazy"}
                fetchpriority={index < 2 ? "high" : "auto"}
              />
            ))}
          </ul>
        </section>
      );
    })}
  </main>
  <Footer />
</Layout>

<style>
  /* ── 分类卡片墙（仿清羽 categories：轨道光点 + 悬停辉光）── */
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1rem;
  }
  .cat-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--border) 45%, transparent);
    background: color-mix(in srgb, var(--foreground) 3%, var(--background));
    color: var(--foreground);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.3s,
      box-shadow 0.3s;
  }
  .cat-card:hover {
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    box-shadow:
      0 10px 40px -10px color-mix(in srgb, var(--accent) 18%, transparent),
      0 0 0 1px color-mix(in srgb, var(--accent) 8%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--accent) 6%, transparent);
    transform: translateY(-3px);
  }
  .cat-content {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .cat-name {
    font-size: 1.0625rem;
    font-weight: 700;
    transition: color 0.2s, text-shadow 0.3s;
  }
  .cat-card:hover .cat-name {
    color: var(--accent);
    text-shadow: 0 0 20px color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .cat-count {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .cat-count-number {
    color: var(--accent);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
    font-family: var(--font-firacode), monospace;
    transition: text-shadow 0.3s;
  }
  .cat-card:hover .cat-count-number {
    text-shadow: 0 0 15px color-mix(in srgb, var(--accent) 50%, transparent);
  }
  .cat-count-label {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.5;
    font-size: 0.8125rem;
  }
  /* 轨道装饰：渐变线 + 三个光点 */
  .cat-orbit {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.38rem;
    height: 0.5rem;
  }
  .cat-orbit::before {
    content: "";
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--accent) 36%, transparent),
      transparent
    );
  }
  .cat-orbit span {
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow: 0 0 10px color-mix(in srgb, var(--accent) 28%, transparent);
    transition: background-color 0.25s, box-shadow 0.25s, transform 0.25s;
  }
  .cat-orbit span:nth-child(2) {
    opacity: 0.72;
    width: 0.24rem;
    height: 0.24rem;
  }
  .cat-orbit span:nth-child(3) {
    opacity: 0.48;
    width: 0.16rem;
    height: 0.16rem;
  }
  .cat-card:hover .cat-orbit span {
    background: var(--accent);
    box-shadow:
      0 0 12px color-mix(in srgb, var(--accent) 58%, transparent),
      0 0 28px color-mix(in srgb, var(--accent) 22%, transparent);
    transform: translate(-2px);
  }
  /* 悬停跟随光斑 */
  .cat-aurora {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0;
    background: radial-gradient(
      300px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      color-mix(in srgb, var(--accent) 8%, transparent),
      transparent 65%
    );
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .cat-card:hover .cat-aurora {
    opacity: 1;
  }
  @media (width <= 480px) {
    .cat-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // 卡片光标跟随光斑
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-cat-card]").forEach(card => {
      const glow = card.querySelector("[data-cat-aurora]") as HTMLElement;
      card.addEventListener("pointermove", e => {
        const rect = card.getBoundingClientRect();
        glow.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
        glow.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
      });
    });
  });
</script>
