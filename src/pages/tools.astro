---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { tools } from "@/data/tools";
import { SITE } from "@/config";

const title = "工具 | " + SITE.title;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  url: new URL("/tools/", SITE.website).toString(),
  description: "我收藏的实用在线工具集合。",
  isPartOf: { "@type": "WebSite", name: SITE.title, url: SITE.website },
};

// 按标签分组（取每个工具的首个 tag；无 tag 归入「其它」）
const groups = (() => {
  const map = new Map<string, typeof tools>();
  for (const t of tools) {
    const key = t.tags?.[0] ?? "其它";
    if (!map.has(key)) map.set(key, []);
    map.get(key)!.push(t);
  }
  return [...map.entries()];
})();
const totalCount = tools.length;
---

<Layout title={title} description="茗辰原收藏的实用在线工具" structuredData={structuredData}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-12">
    <!-- Hero -->
    <div class="archive-hero" data-archive-hero>
      <div class="aurora-orb aurora-orb-1"></div>
      <div class="aurora-orb aurora-orb-2"></div>
      <div class="aurora-orb aurora-orb-3"></div>
      <div class="aurora-mouse" data-archive-mouse></div>
      <div class="relative z-10">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          <span class="glow-text">Tools</span>
        </h1>
        <p class="mt-3 max-w-lg text-foreground/70 italic">
          我收藏的实用在线工具。
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <span class="hero-badge">{totalCount} 个工具</span>
        </div>
      </div>
    </div>

    <!-- Tag groups -->
    {
      groups.map(([tag, list]) => (
        <section class="mt-10 first:mt-8">
          <h2 class="mb-4 flex items-baseline gap-3">
            <span class="text-xl font-bold tracking-tight text-foreground">{tag}</span>
            <span class="font-firacode text-xs text-foreground/40">{list.length}</span>
            <span class="h-px flex-1 bg-border/20" />
          </h2>
          <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
            {list.map(tool => (
              <li>
                <a
                  href={tool.url}
                  target="_blank"
                  rel="noopener"
                  class="tool-card group flex h-full flex-col rounded-xl border border-border/25 bg-foreground/[0.03] p-5 transition-all hover:-translate-y-1 hover:border-accent/40 hover:shadow-lg hover:shadow-accent/10"
                >
                  <h3 class="font-medium transition-colors group-hover:text-accent">{tool.title}</h3>
                  <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-foreground/55">
                    {tool.description}
                  </p>
                  <span class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-accent/70 transition-colors group-hover:text-accent">
                    前往
                    <svg class="size-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
  <Footer />
</Layout>
