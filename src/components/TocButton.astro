---
/**
 * TocButton — 文章目录（右下角浮动按钮 + HUD 弹出面板）
 *
 * 设计参考
 *  - mingcy.cn 旧站 astro-gyoza/src/components/post/PostToc.tsx：
 *    framer-motion `layoutId` 共享指示条（accent bar 在条目间弹簧位移）+
 *    条目默认弱化、hover 显现 + 激活项自动滚进视野。
 *    这里用原生 `transform` + `height` 过渡复刻，效果一致但零 JS 体积
 *    （项目当前零 React 组件，且首屏 JS 有 226KB→26KB 的性能红线）。
 *  - blog.liushen.fun 的 sidebar-toc：app-card-glow 发光卡片 +
 *    data-toc-depth 层级轨道 + 顶部光带。
 *
 * 服务端：astro:content 的 render() 返回 headings，构建树并渲染 HTML
 * 客户端：rAF 节流的滚动探测线驱动「共享指示条 / 读数 / 进度条」
 */
interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const { headings } = Astro.props;

// ── 构建树形结构（index 用于面板读数）──
type TocNode = {
  depth: number;
  slug: string;
  text: string;
  index: number;
  children: TocNode[];
};

let counter = 0;
const tree: TocNode[] = [];
const stack: TocNode[] = [];
for (const h of headings) {
  counter += 1;
  // 归一化：部分文章正文带 h1（会重复页面标题），把 h1 折叠成 h2，
  // 否则紧随 h1 的 h2 会被错误挂成 h1 的子节点
  const depth = Math.max(2, h.depth);
  const node: TocNode = { ...h, depth, index: counter, children: [] };
  while (stack.length && stack[stack.length - 1].depth >= h.depth) {
    stack.pop();
  }
  if (stack.length) stack[stack.length - 1].children.push(node);
  else tree.push(node);
  stack.push(node);
}

// ── 递归渲染 HTML ──
// 缩进：(depth - 2) * 12px —— h2=0, h3=12, h4=24, h5=36
function renderTree(nodes: TocNode[]): string {
  return nodes
    .map((n) => {
      const indent = Math.max(0, (n.depth - 2) * 12);
      const childrenHtml = n.children.length
        ? `<div class="toc-children">${renderTree(n.children)}</div>`
        : "";
      return `<div class="toc-node" style="padding-left:${indent}px" data-depth="${n.depth}">
        <div class="toc-row" data-index="${n.index}">
          <a href="#${n.slug}" class="toc-link" data-slug="${n.slug}">${n.text}</a>
        </div>${childrenHtml}
      </div>`;
    })
    .join("");
}

const treeHtml = renderTree(tree);
const total = headings.length;
const totalPad = String(total).padStart(2, "0");
---

    <div
      id="toc-fab-container"
      data-open="false"
      class="pointer-events-none fixed end-4 bottom-24 z-50 md:end-8 md:bottom-28"
    >
      <!-- ═══ 浮动按钮 ═══ -->
      <button
        id="toc-fab"
        type="button"
        aria-label="打开目录"
        aria-expanded="false"
        title="目录"
        class:list={[
          "pointer-events-auto group relative flex flex-col items-center justify-center gap-0.5",
          "size-14 rounded-full",
          "md:size-16",
          "border border-accent/20 bg-background/80 backdrop-blur-md",
          "shadow-[0_4px_20px_rgba(0,0,0,0.20)] dark:shadow-[0_4px_20px rgba(0,0,0,0.60)]",
          "hover:scale-105 active:scale-95 motion-reduce:hover:scale-100 motion-reduce:active:scale-100",
          "transition-all duration-200 ease-out motion-reduce:transition-none",
          "text-foreground/75 hover:text-accent",
        ]}
      >
        <svg
          class="toc-fab-icon size-5 md:size-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="14" y2="12"></line>
          <line x1="4" y1="18" x2="10" y2="18"></line>
        </svg>
        <span class="toc-fab-label">TOC</span>
      </button>

      <!-- ═══ HUD 弹出面板 ═══ -->
      <div
        id="toc-panel"
        class="pointer-events-auto absolute bottom-full mb-3 end-0 flex flex-col overflow-hidden rounded-2xl"
        style="width: min(72vw, 19rem); max-height: min(60vh, 30rem);"
        role="dialog"
        aria-label="文章目录"
      >
        <!-- 顶部光带 -->
        <div class="toc-beam" aria-hidden="true"></div>

        <!-- 头部 -->
        <header class="toc-header">
          <div class="toc-title">
            <span class="toc-title-dot" aria-hidden="true"></span>
            目录
          </div>
          <div class="toc-readout" aria-hidden="true">
            <span class="toc-readout-cur" id="toc-cur">01</span>
            <span class="toc-readout-sep">/</span>
            <span class="toc-readout-total">{totalPad}</span>
          </div>
          <button
            id="toc-close"
            type="button"
            aria-label="关闭目录"
            class="grid place-items-center size-6 rounded-full text-foreground/50 hover:text-accent hover:bg-accent/10 transition-colors"
          >
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </header>

        <!-- 阅读进度 -->
        <div class="toc-progress-wrap">
          <div class="toc-progress">
            <div class="toc-progress-fill" id="toc-fill"></div>
          </div>
          <span class="toc-progress-pct" id="toc-pct">0%</span>
        </div>

        <!-- 树形列表 -->
        <nav id="toc-list" class="toc-list overflow-y-auto p-2.5 pb-3">
          <div id="toc-tree" class="toc-tree">
            <!-- 共享指示条（跨条目弹簧位移）-->
            <div id="toc-indicator" class="toc-indicator" aria-hidden="true"></div>
            <div set:html={treeHtml}></div>
          </div>

          <!-- 分割线 -->
          <div class="toc-divider"></div>

          <!-- 固定「评论」导航项 -->
          <a
            href="#comments"
            class="toc-row toc-comment-item"
            data-toc-comment
          >
            <span class="toc-emoji" aria-hidden="true">💬</span>
            <span class="toc-link">评论</span>
          </a>
        </nav>
      </div>
    </div>

    <style>
      /* ═══ 浮动按钮 ═══ */
      .toc-fab-icon {
        transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      #toc-fab-container[data-open="true"] .toc-fab-icon {
        transform: rotate(90deg);
      }
      .toc-fab-label {
        font-size: 7px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0;
        transition: opacity 0.2s ease-out;
      }
      #toc-fab:hover .toc-fab-label {
        opacity: 0.6;
      }
      #toc-fab-container[data-open="true"] #toc-fab {
        border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
        box-shadow:
          0 6px 28px color-mix(in srgb, var(--color-accent) 32%, transparent),
          0 0 0 1px color-mix(in srgb, var(--color-accent) 12%, transparent);
      }

      /* ═══ 面板外壳：发光卡片 + 扫描线纹理 ═══ */
      #toc-panel {
        background:
          repeating-linear-gradient(
            to bottom,
            color-mix(in srgb, var(--color-foreground) 2.4%, transparent) 0 1px,
            transparent 1px 3px
          ),
          color-mix(in srgb, var(--color-background) 90%, transparent);
        border: 1px solid
          color-mix(in srgb, var(--color-accent) 24%, var(--color-border));
        box-shadow:
          0 10px 44px rgba(0, 0, 0, 0.3),
          0 0 34px color-mix(in srgb, var(--color-accent) 16%, transparent),
          inset 0 1px 0
            color-mix(in srgb, var(--color-foreground) 10%, transparent);
      }
      .toc-beam {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 2px;
        z-index: 3;
        pointer-events: none;
        background: linear-gradient(
          90deg,
          transparent 0%,
          color-mix(in srgb, var(--color-accent) 65%, transparent) 20%,
          var(--color-accent) 50%,
          color-mix(in srgb, var(--color-accent) 65%, transparent) 80%,
          transparent 100%
        );
        box-shadow: 0 0 12px color-mix(in srgb, var(--color-accent) 60%, transparent);
      }

      /* ═══ 头部 ═══ */
      .toc-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 0.85rem 0.5rem;
        border-bottom: 1px solid color-mix(in srgb, var(--color-border) 25%, transparent);
        flex-shrink: 0;
      }
      .toc-title {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: var(--color-foreground);
        line-height: 1;
      }
      .toc-title-dot {
        width: 0.375rem;
        height: 0.375rem;
        border-radius: 9999px;
        background: var(--color-accent);
        box-shadow:
          0 0 6px color-mix(in srgb, var(--color-accent) 80%, transparent),
          0 0 14px color-mix(in srgb, var(--color-accent) 40%, transparent);
        animation: toc-pulse 2.4s ease-in-out infinite;
      }
      @keyframes toc-pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.35;
        }
      }

      /* 当前章节读数 */
      .toc-readout {
        margin-left: auto;
        display: flex;
        align-items: baseline;
        gap: 0.2rem;
        font-family: var(--font-firacode), ui-monospace, "SF Mono", monospace;
        font-variant-numeric: tabular-nums;
        line-height: 1;
      }
      .toc-readout-cur {
        font-size: 0.9375rem;
        font-weight: 700;
        color: var(--color-accent);
        text-shadow: 0 0 10px
          color-mix(in srgb, var(--color-accent) 55%, transparent);
      }
      .toc-readout-sep,
      .toc-readout-total {
        font-size: 0.6875rem;
        color: color-mix(in srgb, var(--color-foreground) 45%, transparent);
      }

      /* ═══ 阅读进度 ═══ */
      .toc-progress-wrap {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.85rem 0.1rem;
        flex-shrink: 0;
      }
      .toc-progress {
        position: relative;
        flex: 1;
        height: 2px;
        border-radius: 9999px;
        overflow: hidden;
        background: color-mix(in srgb, var(--color-border) 60%, transparent);
      }
      .toc-progress-fill {
        height: 100%;
        width: 0%;
        border-radius: inherit;
        background: linear-gradient(
          90deg,
          color-mix(in srgb, var(--color-accent) 35%, transparent),
          var(--color-accent)
        );
        box-shadow: 0 0 8px color-mix(in srgb, var(--color-accent) 55%, transparent);
        transition: width 0.16s linear;
      }
      .toc-progress-pct {
        font-family: var(--font-firacode), ui-monospace, monospace;
        font-variant-numeric: tabular-nums;
        font-size: 0.6563rem;
        min-width: 2.4rem;
        text-align: right;
        color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
      }

      /* ═══ 列表容器 ═══ */
      .toc-list {
        scrollbar-width: thin;
        scrollbar-color: color-mix(in srgb, var(--color-accent) 30%, transparent)
          transparent;
      }
      .toc-list::-webkit-scrollbar {
        width: 4px;
      }
      .toc-list::-webkit-scrollbar-thumb {
        background: color-mix(in srgb, var(--color-accent) 28%, transparent);
        border-radius: 10px;
      }

      /* 树的定位上下文（共享指示条与条目共用坐标系）*/
      .toc-tree {
        position: relative;
      }

      /* ═══ 条目行 ═══ */
      .toc-row {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.3rem 0.5rem 0.3rem 0.75rem;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: background-color 0.22s ease-out;
      }
      /* 条目左侧轨道刻度 */
      .toc-row::before {
        content: "";
        position: absolute;
        left: 3px;
        top: 50%;
        width: 2px;
        height: 9px;
        transform: translateY(-50%);
        border-radius: 9999px;
        background: color-mix(
          in srgb,
          var(--color-foreground) 16%,
          transparent
        );
        transition:
          height 0.28s ease-out,
          opacity 0.28s ease-out,
          background-color 0.28s ease-out;
      }
      .toc-row:hover {
        background: color-mix(in srgb, var(--color-accent) 7%, transparent);
      }

      /* 链接：默认弱化，聚焦当前章节（参考 gyoza 的 opacity-0 + hover 显现）*/
      .toc-link {
        flex: 1;
        min-width: 0;
        text-decoration: none;
        color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
        font-size: 0.8rem;
        line-height: 1.4;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        opacity: 0.5;
        transition:
          opacity 0.3s ease-out,
          color 0.24s ease-out;
      }
      #toc-fab-container:hover .toc-link {
        opacity: 0.95;
      }
      .toc-row:hover .toc-link {
        opacity: 1;
        color: var(--color-accent);
      }
      .toc-row.is-active {
        background: color-mix(in srgb, var(--color-accent) 11%, transparent);
      }
      .toc-row.is-active .toc-link {
        opacity: 1;
        color: var(--color-accent);
        font-weight: 650;
      }
      /* 激活项让出刻度位置给共享指示条 */
      .toc-row.is-active::before {
        height: 13px;
        opacity: 0;
      }

      /* 层级字号与字重 */
      .toc-node[data-depth="2"] > .toc-row .toc-link {
        font-size: 0.83rem;
        font-weight: 650;
        color: var(--color-foreground);
      }
      .toc-node[data-depth="3"] > .toc-row .toc-link {
        font-size: 0.77rem;
        font-weight: 500;
      }
      .toc-node[data-depth="4"] > .toc-row .toc-link,
      .toc-node[data-depth="5"] > .toc-row .toc-link {
        font-size: 0.72rem;
        font-weight: 400;
      }

      /* 祖先链路：链路高亮 */
      .toc-node.is-ancestor .toc-link {
        opacity: 0.78;
        color: color-mix(
          in srgb,
          var(--color-accent) 50%,
          var(--color-foreground)
        );
      }
      .toc-node.is-ancestor > .toc-row::before {
        background: color-mix(
          in srgb,
          var(--color-accent) 45%,
          transparent
        );
      }

      /* 子列表：层级轨道 */
      .toc-children {
        margin-left: 6px;
        padding-left: 14px;
        border-left: 1px dashed
          color-mix(in srgb, var(--color-border) 62%, transparent);
        transition: border-color 0.35s ease-out;
      }
      .toc-node.is-ancestor > .toc-children {
        border-color: color-mix(in srgb, var(--color-accent) 48%, transparent);
      }

      /* ═══ 共享指示条（跨条目弹簧位移）═══ */
      .toc-indicator {
        position: absolute;
        left: 0;
        top: 0;
        width: 3px;
        height: 0;
        border-radius: 9999px;
        background: linear-gradient(
          180deg,
          var(--color-accent),
          color-mix(in srgb, var(--color-accent) 30%, transparent)
        );
        box-shadow:
          0 0 10px color-mix(in srgb, var(--color-accent) 70%, transparent),
          0 0 22px color-mix(in srgb, var(--color-accent) 28%, transparent);
        transform: translate(0px, -16px);
        opacity: 0;
        transition:
          transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
          height 0.5s cubic-bezier(0.22, 1, 0.36, 1),
          opacity 0.25s ease-out;
        pointer-events: none;
        z-index: 2;
      }

      /* ═══ 分割线 + 评论项 ═══ */
      .toc-divider {
        position: relative;
        margin: 0.5rem 0.7rem;
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent,
          color-mix(in srgb, var(--color-border) 55%, transparent),
          transparent
        );
      }
      .toc-comment-item {
        margin: 0 0.35rem;
      }
      .toc-comment-item::before {
        display: none;
      }
      .toc-comment-item .toc-link {
        opacity: 1;
        font-size: 0.8rem;
      }
      .toc-emoji {
        font-size: 0.78rem;
        line-height: 1;
        opacity: 0.85;
      }

      /* ═══ 面板显隐：可反转的打开 / 关闭过渡 ═══ */
      #toc-panel {
        opacity: 0;
        transform: translateY(0.5rem) scale(0.96);
        transform-origin: bottom right;
        pointer-events: none;
        visibility: hidden;
        transition:
          opacity 0.2s ease-out,
          transform 0.26s cubic-bezier(0.34, 1.4, 0.5, 1),
          visibility 0s linear 0.26s;
      }
      #toc-fab-container[data-open="true"] #toc-panel {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: auto;
        visibility: visible;
        transition:
          opacity 0.2s ease-out,
          transform 0.26s cubic-bezier(0.34, 1.4, 0.5, 1),
          visibility 0s;
      }

      @media (prefers-reduced-motion: reduce) {
        #toc-panel,
        #toc-fab-container[data-open="true"] #toc-panel,
        .toc-fab-icon,
        .toc-row,
        .toc-row::before,
        .toc-link,
        .toc-children,
        .toc-indicator,
        .toc-title-dot {
          transition: none;
          animation: none;
        }
        #toc-panel,
        #toc-fab-container[data-open="true"] #toc-panel {
          transition: visibility 0s;
        }
      }

      /* 移动端面板尺寸 */
      @media (max-width: 640px) {
        #toc-panel {
          max-height: 56vh;
        }
      }
    </style>

    <script>
      // ═══ 客户端：滚动探测线驱动「共享指示条 / 读数 / 进度条」═══
      let tocCleanup: AbortController | null = null;

      document.addEventListener("astro:page-load", () => {
        if (tocCleanup) tocCleanup.abort();
        tocCleanup = new AbortController();
        const { signal } = tocCleanup;

        const fab = document.getElementById("toc-fab");
        const fabContainer = document.getElementById("toc-fab-container");
        const list = document.getElementById("toc-list");
        const treeEl = document.getElementById("toc-tree");
        const indicator = document.getElementById("toc-indicator");
        const closeBtn = document.getElementById("toc-close");
        const curEl = document.getElementById("toc-cur");
        const fillEl = document.getElementById("toc-fill");
        const pctEl = document.getElementById("toc-pct");
        if (!fab || !fabContainer || !list || !treeEl || !indicator) return;

        const isOpen = () => fabContainer.getAttribute("data-open") === "true";
        const open = () => {
          fabContainer.setAttribute("data-open", "true");
          fab.setAttribute("aria-expanded", "true");
          fab.setAttribute("aria-label", "关闭目录");
          refresh();
        };
        const close = () => {
          fabContainer.setAttribute("data-open", "false");
          fab.setAttribute("aria-expanded", "false");
          fab.setAttribute("aria-label", "打开目录");
        };

        // 浮动按钮开关
        fab.addEventListener(
          "click",
          (e) => {
            e.stopPropagation();
            isOpen() ? close() : open();
          },
          { signal }
        );
        closeBtn?.addEventListener("click", close, { signal });

        // 点击面板外部关闭
        document.addEventListener(
          "click",
          (e) => {
            if (isOpen() && !fabContainer.contains(e.target as Node)) close();
          },
          { signal }
        );

        // ESC 关闭
        document.addEventListener(
          "keydown",
          (e) => {
            if (e.key === "Escape" && isOpen()) close();
          },
          { signal }
        );

        // 点击目录项：平滑滚动 + 关闭面板
        list.addEventListener(
          "click",
          (e) => {
            const target = e.target as HTMLElement;
            const commentLink = target.closest<HTMLElement>("[data-toc-comment]");
            const tocLink = target.closest<HTMLElement>("[data-slug]");

            let id: string | null = null;
            if (commentLink) {
              id = "comments";
            } else if (tocLink) {
              id = tocLink.getAttribute("data-slug");
            }
            if (!id) return;

            e.preventDefault();
            const el = document.getElementById(id);
            if (el) {
              el.scrollIntoView({ behavior: "smooth", block: "start" });
              history.replaceState(null, "", `#${id}`);
            }
            close();
          },
          { signal }
        );

        // ── 构建索引 ──
        // 每个条目预缓存「对应行 / 严格祖先 toc-node / 文档内绝对 top」，
        // 滚动时只做常量级类名操作与一次 transform 写入
        type TocItem = {
          id: string;
          index: number;
          heading: HTMLElement;
          row: HTMLElement;
          ancestors: HTMLElement[];
          top: number;
        };
        const items: TocItem[] = [];
        list.querySelectorAll<HTMLElement>("[data-slug]").forEach((link) => {
          const id = link.getAttribute("data-slug");
          const row = link.closest<HTMLElement>(".toc-row");
          const heading = id ? document.getElementById(id) : null;
          if (!id || !row || !heading) return;

          // 收集严格祖先的 .toc-node（跳过自身所在的那一层）
          const ancestors: HTMLElement[] = [];
          let own = false;
          let el = row.parentElement;
          while (el && el !== treeEl) {
            if (el.classList.contains("toc-node")) {
              if (own) ancestors.push(el);
              else own = true;
            }
            el = el.parentElement;
          }
          items.push({
            id,
            index: parseInt(row.dataset.index || "1", 10),
            heading,
            row,
            ancestors,
            top: 0,
          });
        });

        if (!items.length) return;

        // 探测线：视口顶部往下 18%，标题越过此线即算当前章节
        const PROBE_RATIO = 0.18;
        let rafId = 0;
        let active: TocItem | null = null;

        const measure = () => {
          items.forEach((it) => {
            it.top = it.heading.getBoundingClientRect().top + window.scrollY;
          });
          items.sort((a, b) => a.top - b.top);
        };

        // 共享指示条：位置与高度贴合当前条目
        const moveIndicator = (it: TocItem) => {
          indicator.style.opacity = "1";
          indicator.style.transform = `translate(${it.row.offsetLeft + 4}px, ${
            it.row.offsetTop + 2
          }px)`;
          indicator.style.height = `${Math.max(14, it.row.offsetHeight - 4)}px`;
        };

        const activate = (it: TocItem) => {
          if (active && active !== it) {
            active.row.classList.remove("is-active");
            active.ancestors.forEach((n) => n.classList.remove("is-ancestor"));
          }
          it.row.classList.add("is-active");
          it.ancestors.forEach((n) => n.classList.add("is-ancestor"));
          active = it;

          if (curEl) curEl.textContent = String(it.index).padStart(2, "0");
          moveIndicator(it);
          // 激活项滚进面板可见区域（参考 gyoza 的 block:'nearest'）
          it.row.scrollIntoView({ block: "nearest", behavior: "smooth" });

          const label = it.row.textContent?.trim() || "";
          fab.title = label ? `目录 · 当前：${label}` : "目录";
        };

        const scheduleUpdate = () => {
          if (rafId) return;
          rafId = requestAnimationFrame(() => {
            rafId = 0;

            // 阅读进度
            const doc = document.documentElement;
            const docHeight = doc.scrollHeight;
            const range = docHeight - window.innerHeight;
            const ratio =
              range > 0
                ? Math.min(1, Math.max(0, window.scrollY / range))
                : 0;
            if (fillEl) fillEl.style.width = `${(ratio * 100).toFixed(1)}%`;
            if (pctEl) pctEl.textContent = `${Math.round(ratio * 100)}%`;

            // 当前章节
            const probe = window.scrollY + window.innerHeight * PROBE_RATIO;
            let current = items[0];
            for (const it of items) {
              if (it.top <= probe) current = it;
              else break;
            }
            // 滚到底部固定最后一节
            if (window.innerHeight + window.scrollY >= docHeight - 2) {
              current = items[items.length - 1];
            }
            if (current !== active) activate(current);
          });
        };

        let resizeRaf = 0;
        const reMeasure = () => {
          if (resizeRaf) return;
          resizeRaf = requestAnimationFrame(() => {
            resizeRaf = 0;
            measure();
            if (active) moveIndicator(active);
            scheduleUpdate();
          });
        };

        const refresh = () => {
          measure();
          scheduleUpdate();
        };

        measure();
        scheduleUpdate();

        // 滚动 / 尺寸变化 / 字体与图片加载导致布局重排时都要跟上
        window.addEventListener("scroll", scheduleUpdate, {
          passive: true,
          signal,
        });
        window.addEventListener("resize", reMeasure, {
          passive: true,
          signal,
        });
        if (document.fonts) {
          document.fonts.ready.then(reMeasure).catch(() => {});
        }
        document
          .getElementById("main-content")
          ?.querySelectorAll("img")
          .forEach((img) => {
            if (!img.complete) {
              img.addEventListener("load", reMeasure, { signal, once: true });
            }
          });
      });
    </script>
