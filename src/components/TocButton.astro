---
/**
 * TocButton — 文章目录（右下角浮动按钮 + HUD 弹出面板）
 *
 * 设计参考
 *  - mingcy.cn 旧站 astro-gyoza/src/components/post/PostToc.tsx：
 *    framer-motion `layoutId` 共享指示条（accent bar 在条目间弹簧位移）+
 *    条目默认弱化、hover 显现 + 激活项自动滚进视野。
 *    这里用原生 `transform` + `height` 过渡复刻，效果一致但零 JS 体积
 *    （项目当前零 React 组件，且首屏 JS 有 226KB→26KB 的性能红线）。
 *  - blog.liushen.fun 的 sidebar-toc：app-card-glow 发光卡片 +
 *    data-toc-depth 层级轨道 + 顶部光带。
 *
 * 服务端：astro:content 的 render() 返回 headings，构建树并渲染 HTML
 * 客户端：rAF 节流的滚动探测线驱动「共享指示条 / 读数 / 进度条」
 */
import { buildTocTree, renderTocTree } from "@/utils/tocTree";

interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const { headings } = Astro.props;

const tree = buildTocTree(headings);
const treeHtml = renderTocTree(tree);
const total = headings.length;
const totalPad = String(total).padStart(2, "0");
---

    <div
      id="toc-fab-container"
      data-open="false"
      class="pointer-events-none fixed end-4 bottom-24 z-50 md:end-8 md:bottom-28 lg:hidden"
    >
      <!-- ═══ 浮动按钮 ═══ -->
      <button
        id="toc-fab"
        type="button"
        aria-label="打开目录"
        aria-expanded="false"
        title="目录"
        class:list={[
          "pointer-events-auto group relative flex flex-col items-center justify-center gap-0.5",
          "size-14 rounded-full",
          "md:size-16",
          "border border-accent/20 bg-background/80 backdrop-blur-md",
          "shadow-[0_4px_20px_rgba(0,0,0,0.20)] dark:shadow-[0_4px_20px rgba(0,0,0,0.60)]",
          "hover:scale-105 active:scale-95 motion-reduce:hover:scale-100 motion-reduce:active:scale-100",
          "transition-all duration-200 ease-out motion-reduce:transition-none",
          "text-foreground/75 hover:text-accent",
        ]}
      >
        <svg
          class="toc-fab-icon size-5 md:size-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="14" y2="12"></line>
          <line x1="4" y1="18" x2="10" y2="18"></line>
        </svg>
        <span class="toc-fab-label">TOC</span>
      </button>

      <!-- ═══ HUD 弹出面板 ═══ -->
      <div
        id="toc-panel"
        class="pointer-events-auto absolute bottom-full mb-3 end-0 flex flex-col overflow-hidden rounded-2xl"
        style="width: min(72vw, 19rem); max-height: min(60vh, 30rem);"
        role="dialog"
        aria-label="文章目录"
      >
        <!-- 顶部光带 -->
        <div class="toc-beam" aria-hidden="true"></div>

        <!-- 头部 -->
        <header class="toc-header">
          <div class="toc-title">
            <span class="toc-title-dot" aria-hidden="true"></span>
            目录
          </div>
          <div class="toc-readout" aria-hidden="true">
            <span class="toc-readout-cur" id="toc-cur">01</span>
            <span class="toc-readout-sep">/</span>
            <span class="toc-readout-total">{totalPad}</span>
          </div>
          <button
            id="toc-close"
            type="button"
            aria-label="关闭目录"
            class="grid place-items-center size-6 rounded-full text-foreground/50 hover:text-accent hover:bg-accent/10 transition-colors"
          >
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </header>

        <!-- 阅读进度 -->
        <div class="toc-progress-wrap">
          <div class="toc-progress">
            <div class="toc-progress-fill" id="toc-fill"></div>
          </div>
          <span class="toc-progress-pct" id="toc-pct">0%</span>
        </div>

        <!-- 树形列表 -->
        <nav id="toc-list" class="toc-list overflow-y-auto p-2.5 pb-3">
          <div id="toc-tree" class="toc-tree">
            <!-- 共享指示条（跨条目弹簧位移）-->
            <div id="toc-indicator" class="toc-indicator" aria-hidden="true"></div>
            <div set:html={treeHtml}></div>
          </div>

          <!-- 分割线 -->
          <div class="toc-divider"></div>

          <!-- 固定「评论」导航项 -->
          <a
            href="#comments"
            class="toc-row toc-comment-item"
            data-toc-comment
          >
            <span class="toc-emoji" aria-hidden="true">💬</span>
            <span class="toc-text">评论</span>
          </a>
        </nav>
      </div>
    </div>

    <style>
      /* ═══ 浮动按钮 ═══ */
      .toc-fab-icon {
        transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      #toc-fab-container[data-open="true"] .toc-fab-icon {
        transform: rotate(90deg);
      }
      .toc-fab-label {
        font-size: 7px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0;
        transition: opacity 0.2s ease-out;
      }
      #toc-fab:hover .toc-fab-label {
        opacity: 0.6;
      }
      #toc-fab-container[data-open="true"] #toc-fab {
        border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
        box-shadow:
          0 6px 28px color-mix(in srgb, var(--color-accent) 32%, transparent),
          0 0 0 1px color-mix(in srgb, var(--color-accent) 12%, transparent);
      }

      /* ═══ 面板外壳：发光卡片 + 扫描线纹理 ═══ */
      #toc-panel {
        background:
          repeating-linear-gradient(
            to bottom,
            color-mix(in srgb, var(--color-foreground) 2.4%, transparent) 0 1px,
            transparent 1px 3px
          ),
          color-mix(in srgb, var(--color-background) 90%, transparent);
        border: 1px solid
          color-mix(in srgb, var(--color-accent) 24%, var(--color-border));
        box-shadow:
          0 10px 44px rgba(0, 0, 0, 0.3),
          0 0 34px color-mix(in srgb, var(--color-accent) 16%, transparent),
          inset 0 1px 0
            color-mix(in srgb, var(--color-foreground) 10%, transparent);
      }
      .toc-beam {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 2px;
        z-index: 3;
        pointer-events: none;
        background: linear-gradient(
          90deg,
          transparent 0%,
          color-mix(in srgb, var(--color-accent) 65%, transparent) 20%,
          var(--color-accent) 50%,
          color-mix(in srgb, var(--color-accent) 65%, transparent) 80%,
          transparent 100%
        );
        box-shadow: 0 0 12px color-mix(in srgb, var(--color-accent) 60%, transparent);
      }

      /* ═══ 头部 ═══ */
      .toc-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 0.85rem 0.5rem;
        border-bottom: 1px solid color-mix(in srgb, var(--color-border) 25%, transparent);
        flex-shrink: 0;
      }
      .toc-title {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: var(--color-foreground);
        line-height: 1;
      }
      .toc-title-dot {
        width: 0.375rem;
        height: 0.375rem;
        border-radius: 9999px;
        background: var(--color-accent);
        box-shadow:
          0 0 6px color-mix(in srgb, var(--color-accent) 80%, transparent),
          0 0 14px color-mix(in srgb, var(--color-accent) 40%, transparent);
        animation: toc-pulse 2.4s ease-in-out infinite;
      }
      @keyframes toc-pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.35;
        }
      }

      /* 当前章节读数 */
      .toc-readout {
        margin-left: auto;
        display: flex;
        align-items: baseline;
        gap: 0.2rem;
        font-family: var(--font-firacode), ui-monospace, "SF Mono", monospace;
        font-variant-numeric: tabular-nums;
        line-height: 1;
      }
      .toc-readout-cur {
        font-size: 0.9375rem;
        font-weight: 700;
        color: var(--color-accent);
        text-shadow: 0 0 10px
          color-mix(in srgb, var(--color-accent) 55%, transparent);
      }
      .toc-readout-sep,
      .toc-readout-total {
        font-size: 0.6875rem;
        color: color-mix(in srgb, var(--color-foreground) 45%, transparent);
      }

      /* ═══ 阅读进度 ═══ */
      .toc-progress-wrap {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.85rem 0.1rem;
        flex-shrink: 0;
      }
      .toc-progress {
        position: relative;
        flex: 1;
        height: 2px;
        border-radius: 9999px;
        overflow: hidden;
        background: color-mix(in srgb, var(--color-border) 60%, transparent);
      }
      .toc-progress-fill {
        height: 100%;
        width: 0%;
        border-radius: inherit;
        background: linear-gradient(
          90deg,
          color-mix(in srgb, var(--color-accent) 35%, transparent),
          var(--color-accent)
        );
        box-shadow: 0 0 8px color-mix(in srgb, var(--color-accent) 55%, transparent);
        transition: width 0.16s linear;
      }
      .toc-progress-pct {
        font-family: var(--font-firacode), ui-monospace, monospace;
        font-variant-numeric: tabular-nums;
        font-size: 0.6563rem;
        min-width: 2.4rem;
        text-align: right;
        color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
      }

      /* ═══ 列表容器 ═══ */
      .toc-list {
        scrollbar-width: thin;
        scrollbar-color: color-mix(in srgb, var(--color-accent) 30%, transparent)
          transparent;
      }
      .toc-list::-webkit-scrollbar {
        width: 4px;
      }
      .toc-list::-webkit-scrollbar-thumb {
        background: color-mix(in srgb, var(--color-accent) 28%, transparent);
        border-radius: 10px;
      }

      /* 树的定位上下文（共享指示条与条目共用坐标系）+ 几何变量 */
      .toc-tree {
        position: relative;
        --toc-rail: 0.4rem; /* 0 级刻度 x（树主干 x）*/
        --toc-step: 0.85rem; /* 每级缩进步长 */
      }
      /* 树主干：一条贯穿左缘的细线，锚定整棵树的视觉起点 */
      .toc-tree::before {
        content: "";
        position: absolute;
        left: calc(var(--toc-rail) + 1px);
        top: 0.3rem;
        bottom: 0.3rem;
        width: 1px;
        border-radius: 9999px;
        background: linear-gradient(
          to bottom,
          transparent,
          color-mix(in srgb, var(--color-foreground) 10%, transparent) 12%,
          color-mix(in srgb, var(--color-foreground) 10%, transparent) 88%,
          transparent
        );
        pointer-events: none;
      }

      /* ═══ 条目行（重构：真实层级缩进 —— 药丸逐级右移 + 分级刻度 + 树枝肘线）═══ */
      .toc-row {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.3rem 0.5rem 0.3rem
          calc(1.1rem + var(--toc-level) * var(--toc-step));
        border-radius: 0.5rem;
        text-decoration: none;
        cursor: pointer;
        color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
        transition:
          background-color 0.22s ease-out,
          color 0.24s ease-out;
      }
      /* 分级刻度：钉在各自层级 x（0 级在主干上，其余逐级右移成阶梯）*/
      .toc-row::before {
        content: "";
        position: absolute;
        left: calc(var(--toc-rail) + var(--toc-level) * var(--toc-step));
        top: 50%;
        width: 2px;
        height: 1em;
        transform: translateY(-50%);
        border-radius: 9999px;
        background: color-mix(
          in srgb,
          var(--color-foreground) 18%,
          transparent
        );
        transition:
          height 0.28s ease-out,
          opacity 0.28s ease-out,
          background-color 0.28s ease-out;
      }
      /* 树枝肘线：子级行从父级刻度横向连到本级刻度，形成分支 */
      .toc-node[data-depth="3"] .toc-row::after,
      .toc-node[data-depth="4"] .toc-row::after,
      .toc-node[data-depth="5"] .toc-row::after,
      .toc-node[data-depth="6"] .toc-row::after {
        content: "";
        position: absolute;
        left: calc(var(--toc-rail) + (var(--toc-level) - 1) * var(--toc-step));
        top: 50%;
        width: var(--toc-step);
        height: 1.5px;
        transform: translateY(-50%);
        border-radius: 9999px;
        background: color-mix(
          in srgb,
          var(--color-foreground) 13%,
          transparent
        );
        transition: background-color 0.24s ease-out;
      }
      .toc-row:hover {
        background: color-mix(in srgb, var(--color-accent) 7%, transparent);
        color: var(--color-accent);
      }
      .toc-row:hover::after {
        background: color-mix(in srgb, var(--color-accent) 35%, transparent);
      }

      /* 文字：默认弱化，聚焦当前章节（参考 gyoza 的 opacity-0 + hover 显现）*/
      .toc-text {
        display: inline-block;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        vertical-align: middle;
        font-size: 0.8rem;
        line-height: 1.4;
        opacity: 0.55;
        transition: opacity 0.3s ease-out;
      }
      #toc-fab-container:hover .toc-text {
        opacity: 0.95;
      }
      .toc-row:hover .toc-text {
        opacity: 1;
      }
      .toc-row.is-active {
        background: color-mix(in srgb, var(--color-accent) 11%, transparent);
      }
      .toc-row.is-active .toc-text {
        opacity: 1;
        color: var(--color-accent);
        font-weight: 650;
      }
      /* 激活项让出刻度位置给共享指示条（指示条水平跟随该行刻度 x）*/
      .toc-row.is-active::before {
        height: 1.2em;
        opacity: 0;
      }
      .toc-row.is-active::after {
        background: color-mix(in srgb, var(--color-accent) 50%, transparent);
      }

      /* 层级字号与字重 */
      .toc-node[data-depth="2"] .toc-text {
        font-size: 0.83rem;
        font-weight: 650;
      }
      .toc-node[data-depth="3"] .toc-text {
        font-size: 0.77rem;
        font-weight: 500;
      }
      .toc-node[data-depth="4"] .toc-text,
      .toc-node[data-depth="5"] .toc-text {
        font-size: 0.72rem;
        font-weight: 400;
      }

      /* 祖先链路：链路高亮 */
      .toc-node.is-ancestor .toc-row {
        color: color-mix(
          in srgb,
          var(--color-accent) 50%,
          var(--color-foreground)
        );
      }
      .toc-node.is-ancestor .toc-row::before {
        background: color-mix(
          in srgb,
          var(--color-accent) 45%,
          transparent
        );
      }
      .toc-node.is-ancestor .toc-row::after {
        background: color-mix(
          in srgb,
          var(--color-accent) 32%,
          transparent
        );
      }

      /* 子列表容器刻意无样式：保证 row 的 offsetTop / offsetLeft 精确（共享指示条依赖）*/

      /* ═══ 共享指示条（跨条目弹簧位移：水平跟行、垂直跟层、x 由 JS 从行刻度读取）═══ */
      .toc-indicator {
        position: absolute;
        left: 0;
        top: 0;
        width: 2px;
        height: 0;
        border-radius: 9999px;
        background: linear-gradient(
          180deg,
          var(--color-accent),
          color-mix(in srgb, var(--color-accent) 30%, transparent)
        );
        box-shadow:
          0 0 10px color-mix(in srgb, var(--color-accent) 70%, transparent),
          0 0 22px color-mix(in srgb, var(--color-accent) 28%, transparent);
        transform: translate(-8px, -16px);
        opacity: 0;
        transition:
          transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
          height 0.5s cubic-bezier(0.22, 1, 0.36, 1),
          opacity 0.25s ease-out;
        pointer-events: none;
        z-index: 2;
      }

      /* ═══ 分割线 + 评论项 ═══ */
      .toc-divider {
        position: relative;
        margin: 0.5rem 0.7rem;
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent,
          color-mix(in srgb, var(--color-border) 55%, transparent),
          transparent
        );
      }
      .toc-comment-item {
        margin: 0 0.35rem;
      }
      .toc-comment-item::before {
        display: none;
      }
      .toc-comment-item .toc-text {
        opacity: 1;
        font-size: 0.8rem;
      }
      .toc-emoji {
        font-size: 0.78rem;
        line-height: 1;
        opacity: 0.85;
      }

      /* ═══ 面板显隐：可反转的打开 / 关闭过渡 ═══ */
      #toc-panel {
        opacity: 0;
        transform: translateY(0.5rem) scale(0.96);
        transform-origin: bottom right;
        pointer-events: none;
        visibility: hidden;
        transition:
          opacity 0.2s ease-out,
          transform 0.26s cubic-bezier(0.34, 1.4, 0.5, 1),
          visibility 0s linear 0.26s;
      }
      #toc-fab-container[data-open="true"] #toc-panel {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: auto;
        visibility: visible;
        transition:
          opacity 0.2s ease-out,
          transform 0.26s cubic-bezier(0.34, 1.4, 0.5, 1),
          visibility 0s;
      }

      @media (prefers-reduced-motion: reduce) {
        #toc-panel,
        #toc-fab-container[data-open="true"] #toc-panel,
        .toc-fab-icon,
        .toc-row,
        .toc-row::before,
        .toc-row::after,
        .toc-text,
        .toc-indicator,
        .toc-title-dot {
          transition: none;
          animation: none;
        }
        #toc-panel,
        #toc-fab-container[data-open="true"] #toc-panel {
          transition: visibility 0s;
        }
      }

      /* 移动端面板尺寸 */
      @media (max-width: 640px) {
        #toc-panel {
          max-height: 56vh;
        }
      }
    </style>

    <script>
      // ═══ 客户端：滚动探测线驱动「共享指示条 / 读数 / 进度条」═══
      import { initTocHighlight } from "@/scripts/toc-highlight";

      let tocCleanup: AbortController | null = null;

      document.addEventListener("astro:page-load", () => {
        if (tocCleanup) tocCleanup.abort();
        tocCleanup = new AbortController();
        const { signal } = tocCleanup;

        const fab = document.getElementById("toc-fab");
        const fabContainer = document.getElementById("toc-fab-container");
        const list = document.getElementById("toc-list");
        const treeEl = document.getElementById("toc-tree");
        const indicator = document.getElementById("toc-indicator");
        const closeBtn = document.getElementById("toc-close");
        const curEl = document.getElementById("toc-cur");
        const fillEl = document.getElementById("toc-fill");
        const pctEl = document.getElementById("toc-pct");
        if (!fab || !fabContainer || !list || !treeEl || !indicator) return;

        const toc = initTocHighlight({
          list,
          tree: treeEl,
          indicator,
          curEl,
          fillEl,
          pctEl,
          fab,
          signal,
        });

        const isOpen = () =>
          fabContainer.getAttribute("data-open") === "true";
        const open = () => {
          fabContainer.setAttribute("data-open", "true");
          fab.setAttribute("aria-expanded", "true");
          fab.setAttribute("aria-label", "关闭目录");
          toc?.refresh();
        };
        const close = () => {
          fabContainer.setAttribute("data-open", "false");
          fab.setAttribute("aria-expanded", "false");
          fab.setAttribute("aria-label", "打开目录");
        };

        // 浮动按钮开关
        fab.addEventListener(
          "click",
          (e) => {
            e.stopPropagation();
            isOpen() ? close() : open();
          },
          { signal }
        );
        closeBtn?.addEventListener("click", close, { signal });

        // 点击面板外部关闭
        document.addEventListener(
          "click",
          (e) => {
            if (isOpen() && !fabContainer.contains(e.target as Node)) close();
          },
          { signal }
        );

        // ESC 关闭
        document.addEventListener(
          "keydown",
          (e) => {
            if (e.key === "Escape" && isOpen()) close();
          },
          { signal }
        );

        // 点击目录项：平滑滚动 + 关闭面板
        list.addEventListener(
          "click",
          (e) => {
            const target = e.target as HTMLElement;
            const commentLink = target.closest<HTMLElement>("[data-toc-comment]");
            const tocLink = target.closest<HTMLElement>("[data-slug]");

            let id: string | null = null;
            if (commentLink) {
              id = "comments";
            } else if (tocLink) {
              id = tocLink.getAttribute("data-slug");
            }
            if (!id) return;

            e.preventDefault();
            const el = document.getElementById(id);
            if (el) {
              el.scrollIntoView({ behavior: "smooth", block: "start" });
              history.replaceState(null, "", `#${id}`);
            }
            close();
          },
          { signal }
        );
      });
    </script>
