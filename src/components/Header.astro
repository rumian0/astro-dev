---
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import Logo from "@/assets/logo/devosfera.svg";
import MobileMenu from "./MobileMenu.astro";
import IntroAudioCompact from "./IntroAudioCompact.astro";
import { SITE } from "@/config";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

// 导航项类型：扁平链接或下拉分组
interface NavItem {
  label: string;
  href?: string;
  items?: { label: string; href: string; external?: boolean }[];
}
const navItems = SITE.nav as unknown as readonly NavItem[];

// 分组是否 active：任一子项命中
const isGroupActive = (items: { href: string }[]) =>
  items.some(it => isActive(it.href));
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 rounded-b-lg bg-accent px-4 py-2 font-medium text-background transition-all focus:top-0"
>
  Skip to content
</a>

<header id="main-header" class="sticky top-0 z-40 w-full transition-colors duration-300">
  <div class="header-scrolled-filter w-full">
    <div class="app-layout">
      <div
        id="top-nav-wrap"
        class:list={[
          "py-3 sm:py-5",
          "relative w-full",
          "flex items-center justify-between gap-2 sm:gap-4",
          "transition-all duration-300",
        ]}
      >
        <!-- Logo -->
        <a
          href="/"
          class="group relative z-20 flex items-center gap-2 text-xl font-bold tracking-tight sm:text-2xl shrink-0"
        >
          <!-- <span class="nav-logo-text">{SITE.title}</span> -->
          <Logo class="w-37.5 dark:invert" />
        </a>

        <!-- Center Audio Player -->
        {
          SITE.introAudio.enabled && (
            <div class="flex-1 flex justify-center min-w-0">
              <IntroAudioCompact
                src={SITE.introAudio.src}
                label={SITE.introAudio.label}
                duration={SITE.introAudio.duration}
                isStream={SITE.introAudio.isStream}
                class="nav-intro-audio-compact"
              />
            </div>
          )
        }

        <!-- Nav area -->
        <nav id="nav-menu" class="flex items-center sm:gap-1 shrink-0">
          <!-- Mobile hamburger (animated lines) -->
          <button
            id="menu-btn"
            class="hamburger-btn sm:hidden"
            aria-label="Open Menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <div class="hamburger-box">
              <span class="hamburger-line hamburger-line--1"></span>
              <span class="hamburger-line hamburger-line--2"></span>
              <span class="hamburger-line hamburger-line--3"></span>
            </div>
          </button>

          <!-- Desktop links (always visible on sm+) —— dropdown mega-menu + glide pill -->
          <ul
            class="nav-menu-list hidden sm:flex sm:flex-row sm:items-center sm:gap-1"
            data-glide-track
          >
            {/* 共用 hover 药丸：位置由 runtime 逐帧写入 */}
            <li class="glide-pill" data-glide-pill aria-hidden="true"></li>

            {
              navItems.map(item => {
                const isGroup = Array.isArray(item.items) && item.items.length > 0;
                if (isGroup) {
                  const active = isGroupActive(item.items!);
                  return (
                    <li class="nav-menu-item relative">
                      <button
                        class:list={["nav-link nav-link-cn nav-dropdown-trigger", { "nav-active": active }]}
                        data-glide-item
                        aria-haspopup="true"
                        aria-expanded="false"
                      >
                        <span>{item.label}</span>
                        <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                      </button>
                      <ul class="nav-dropdown" data-glide-track>
                        <li class="glide-pill" data-glide-pill aria-hidden="true"></li>
                        {item.items!.map(sub => (
                          <li>
                            <a
                              href={sub.href}
                              class:list={["nav-dropdown-link", { "nav-active": isActive(sub.href) }]}
                              data-glide-item
                              target={sub.external ? "_blank" : undefined}
                              rel={sub.external ? "noopener" : undefined}
                            >
                              {sub.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </li>
                  );
                }
                return (
                  <li class="nav-menu-item relative">
                    <a
                      href={item.href}
                      class:list={["nav-link nav-link-cn", { "nav-active": isActive(item.href!) }]}
                      data-glide-item
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })
            }

            <!-- Separator -->
            <li class="flex items-center px-1" aria-hidden="true">
              <div class="h-4 w-px bg-border/30"></div>
            </li>

            <li class="flex items-center">
              <button
                data-search-trigger
                class="nav-search-btn"
                title="Search (⌘K)"
                aria-label="Open search"
                aria-keyshortcuts="Meta+K"
              >
                <IconSearch class="size-4.5" />
                <kbd class="nav-kbd">⌘K</kbd>
              </button>
            </li>
            {
              SITE.lightAndDarkMode && (
                <li class="flex items-center">
                  <button
                    id="theme-btn"
                    class="nav-icon-btn relative"
                    title="Toggles light & dark"
                    aria-label="auto"
                    aria-live="polite"
                  >
                    <IconMoon class="absolute top-1/2 left-1/2 -translate-1/2 scale-100 rotate-0 transition-all duration-300 dark:scale-0 dark:-rotate-90" />
                    <IconSunHigh class="absolute top-1/2 left-1/2 -translate-1/2 scale-0 rotate-90 transition-all duration-300 dark:scale-100 dark:rotate-0" />
                  </button>
                </li>
              )
            }
          </ul>
        </nav>
      </div>
    </div>
  </div>
  <MobileMenu currentPath={currentPath} />

  <!-- Bottom border with gradient -->
  <div
    id="header-border"
    class="header-border-line opacity-0 transition-opacity duration-300 h-px w-full bg-linear-to-r from-transparent via-border/40 to-transparent"
  >
  </div>
</header>

<style>
  /* ─── Header Glass & Scroll Physics ─── */
  #main-header {
    background: transparent;
  }
  
  :global(.header-scrolled) {
    background: color-mix(in srgb, var(--background) 80%, transparent) !important;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
  }

  :global(.header-scrolled .header-scrolled-filter) {
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
  }

  .nav-logo-text {
    background: linear-gradient(
      135deg,
      var(--foreground) 0%,
      var(--foreground) 60%,
      var(--accent) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  :global(.nav-intro-audio-compact) {
    max-width: 100%;
  }

  /* ─── Logo SVG hover effects ─── */
  :global(.logo-text-left),
  :global(.logo-text-right) {
    transition:
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 0.4s ease;
  }
  :global(.logo-sphere) {
    transition:
      transform 0.3s ease,
      filter 0.3s ease;
    transform-origin: 342px 130px;
  }

  .group:hover :global(.logo-text-left) {
    transform: translateX(-5px);
    filter: drop-shadow(0 0 3px rgba(56, 66, 77, 0.2));
  }
  .group:hover :global(.logo-text-right) {
    transform: translateX(5px);
    filter: drop-shadow(0 0 3px rgba(56, 66, 77, 0.2));
  }
  .group:hover :global(.logo-sphere) {
    filter: drop-shadow(0 0 8px rgba(167, 90, 90, 0.5));
    animation: sphere-wiggle 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes sphere-wiggle {
    0% {
      transform: rotate(0deg) scale(1);
    }
    20% {
      transform: rotate(-8deg) scale(1.1);
    }
    40% {
      transform: rotate(5deg) scale(1.15);
    }
    60% {
      transform: rotate(-3deg) scale(1.12);
    }
    80% {
      transform: rotate(1deg) scale(1.05);
    }
    100% {
      transform: rotate(0deg) scale(1);
    }
  }

  /* ─── Desktop nav links ─── */
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--foreground);
    border-radius: 0.5rem;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  /* 中文导航：清羽风格文字链 */
  .nav-link-cn {
    letter-spacing: 0.08em;
    font-weight: 500;
  }

  .nav-link:focus-visible, .nav-icon-btn:focus-visible, .nav-search-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 50%, transparent);
  }

  :is(.nav-link, .nav-icon-btn):hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .nav-active {
    color: var(--accent);
    /* Clean active state for desktop */
    background: transparent;
  }

  /* glide pill 取代原点高亮，作为 hover/active 药丸 */

  .nav-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    transition: color 0.2s ease, background-color 0.2s ease;
    color: var(--foreground);
  }

  /* ─── Desktop Search Button with ⌘K ─── */
  .nav-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3rem 0.5rem 0.3rem 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted-foreground);
    border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--muted) 40%, transparent);
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .nav-search-btn:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .nav-kbd {
    display: inline-flex;
    align-items: center;
    font-family: inherit;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
    border-bottom-width: 2px;
    background: color-mix(in srgb, var(--background) 90%, transparent);
    color: var(--muted-foreground);
    box-shadow: inset 0 -1px 0 rgba(0,0,0,0.1);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .nav-search-btn:hover .nav-kbd {
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
  }

  /* ─── Animated Hamburger Button ─── */
  .hamburger-btn {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.625rem;
    border: 1px solid transparent;
    background: transparent;
    transition: background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }

  @media (min-width: 640px) {
    .hamburger-btn {
      display: none;
    }
  }

  .hamburger-btn:hover,
  .hamburger-btn[aria-expanded="true"] {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent) 15%, transparent);
  }

  .hamburger-box {
    position: relative;
    width: 18px;
    height: 14px;
  }

  .hamburger-line {
    position: absolute;
    left: 0;
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: var(--foreground);
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      top 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hamburger-line--1 {
    top: 0;
  }
  .hamburger-line--2 {
    top: 6px;
  }
  .hamburger-line--3 {
    top: 12px;
    width: 60%;
  }

  /* Open state: morph to X */
  .hamburger-btn[aria-expanded="true"] .hamburger-line {
    background: var(--accent);
  }
  .hamburger-btn[aria-expanded="true"] .hamburger-line--1 {
    top: 6px;
    transform: rotate(45deg);
  }
  .hamburger-btn[aria-expanded="true"] .hamburger-line--2 {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger-btn[aria-expanded="true"] .hamburger-line--3 {
    top: 6px;
    width: 100%;
    transform: rotate(-45deg);
  }

  /* ─── Glide pill（仿清羽：跟随 hover/active 的药丸高亮）─── */
  .nav-menu-list,
  .nav-dropdown {
    position: relative;
  }
  .glide-pill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.28s cubic-bezier(0.34, 1.4, 0.5, 1),
      width 0.28s cubic-bezier(0.34, 1.4, 0.5, 1),
      top 0.28s cubic-bezier(0.34, 1.4, 0.5, 1),
      height 0.28s cubic-bezier(0.34, 1.4, 0.5, 1),
      opacity 0.2s ease;
    z-index: 0;
  }
  .glide-pill.is-active {
    opacity: 1;
  }
  /* 活动态药丸淡色常驻 */
  .glide-pill.is-rest {
    opacity: 0.55;
  }
  .nav-menu-item,
  .nav-dropdown li:not(.glide-pill) {
    position: relative;
    z-index: 1;
  }

  /* ─── 下拉菜单（横向排布）─── */
  .nav-menu-item .nav-dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    padding: 0.4rem;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.1rem;
    list-style: none;
    border: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
    background: color-mix(in srgb, var(--background) 88%, transparent);
    backdrop-filter: blur(18px) saturate(180%);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    border-radius: 0.85rem;
    box-shadow: 0 16px 40px -16px color-mix(in srgb, var(--accent) 35%, transparent);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.22s ease, transform 0.22s cubic-bezier(0.34, 1.4, 0.5, 1), visibility 0.22s;
    z-index: 50;
  }
  .nav-menu-item.is-open .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .nav-menu-item.is-open .nav-chevron {
    transform: rotate(180deg);
  }
  .nav-chevron {
    width: 0.85rem;
    height: 0.85rem;
    opacity: 0.6;
    transition: transform 0.22s ease;
  }
  .nav-dropdown-link {
    position: relative;
    display: block;
    padding: 0.45rem 0.7rem;
    border-radius: 0.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--foreground);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.18s ease, background-color 0.18s ease;
    z-index: 1;
  }
  .nav-dropdown-link:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .nav-dropdown-link.nav-active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .glide-pill { transition: opacity 0.2s ease; }
    .nav-menu-item .nav-dropdown { transition: opacity 0.2s ease; }
  }


</style>

<script>
  let headerCleanup: AbortController | null = null;
  let scrollCleanup: AbortController | null = null;

  function setupScrollPhysics() {
    if (scrollCleanup) scrollCleanup.abort();
    scrollCleanup = new AbortController();
    const { signal } = scrollCleanup;

    const header = document.getElementById("main-header");
    const navWrap = document.getElementById("top-nav-wrap");
    const borderLine = document.getElementById("header-border");

    if (!header || !navWrap || !borderLine) return;

    let rafPending = false;
    const handleScroll = () => {
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(() => {
        const scrolled = window.scrollY > 15;
        header.classList.toggle("header-scrolled", scrolled);
        navWrap.classList.toggle("sm:py-5", !scrolled);
        navWrap.classList.toggle("sm:py-3", scrolled);
        borderLine.classList.toggle("opacity-0", !scrolled);
        borderLine.classList.toggle("opacity-100", scrolled);
        rafPending = false;
      });
    };

    window.addEventListener("scroll", handleScroll, { passive: true, signal });
    handleScroll(); // Init instantly
  }

  function setupMobileNav() {
    // Cleanup previous listeners
    if (headerCleanup) headerCleanup.abort();
    headerCleanup = new AbortController();
    const { signal } = headerCleanup;
    const menuBtn = document.querySelector("#menu-btn");
    const mobileMenu = document.querySelector("#mobile-menu");
    const backdrop = document.querySelector(".mobile-menu-backdrop");

    if (!menuBtn || !mobileMenu) return;
    
    const closeMenu = () => {
      menuBtn.setAttribute("aria-expanded", "false");
      menuBtn.setAttribute("aria-label", "Open Menu");
      mobileMenu.classList.remove("is-open");
      mobileMenu.setAttribute("aria-hidden", "true");
    };

    menuBtn.addEventListener(
      "click",
      () => {
        const isOpen = menuBtn.getAttribute("aria-expanded") === "true";

        if (isOpen) {
          closeMenu();
        } else {
          menuBtn.setAttribute("aria-expanded", "true");
          menuBtn.setAttribute("aria-label", "Close Menu");
          mobileMenu.classList.add("is-open");
          mobileMenu.setAttribute("aria-hidden", "false");
        }
      },
      { signal }
    );
    
    // Close when clicking the backdrop
    if (backdrop) {
      backdrop.addEventListener("click", closeMenu, { signal });
      window.addEventListener("scroll", closeMenu, { passive: true, signal });
    }

    // Close mobile menu on link click
    mobileMenu.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", closeMenu, { signal });
    });
  }

  /* ═══ Glide pill + dropdown 导航逻辑（仿清羽）═══
   * 每个 [data-glide-track] 内共用一个 .glide-pill：
   *   - hover/focus 任一 [data-glide-item] 时，药丸平移覆盖该元素（按元素实际宽高定位）
   *   - 鼠标离开轨道时，药丸回到当前页对应的活动项（若有）
   *   - 下拉组：hover 打开（带关闭延迟防悬停间隙）、点击 toggle、ESC 关闭
   *   - 窗口 resize / 字体加载完成后重新对齐药丸
   */
  let glideCleanup: AbortController | null = null;
  let closeTimers = new Map<HTMLElement, number>();

  function setupGlideNav() {
    if (glideCleanup) glideCleanup.abort();
    glideCleanup = new AbortController();
    const { signal } = glideCleanup;

    const groups = Array.from(
      document.querySelectorAll<HTMLElement>(".nav-menu-item")
    );
    // 导航切换后关闭所有下拉（Header 在 view transitions 中常驻）
    groups.forEach(g => g.classList.remove("is-open"));

    const tracks = document.querySelectorAll<HTMLElement>("[data-glide-track]");
    tracks.forEach(track => {
      const pill = track.querySelector<HTMLElement>(".glide-pill");
      if (!pill) return;
      const items = Array.from(
        track.querySelectorAll<HTMLElement>("[data-glide-item]")
      );
      if (!items.length) return;

      const activeItem =
        items.find(it => it.classList.contains("nav-active")) || null;

      const placeOn = (el: HTMLElement | null, rest = false) => {
        if (!el || !track.isConnected) {
          pill.classList.remove("is-active", "is-rest");
          return;
        }
        const tRect = track.getBoundingClientRect();
        const iRect = el.getBoundingClientRect();
        const x = iRect.left - tRect.left;
        const w = iRect.width;
        const y = iRect.top - tRect.top;
        const h = iRect.height;
        pill.style.transform = `translateX(${x}px)`;
        pill.style.width = `${w}px`;
        pill.style.top = `${y}px`;
        pill.style.height = `${h}px`;
        pill.classList.add("is-active");
        pill.classList.toggle("is-rest", rest);
      };

      // 初始：落在活动项上（淡色常驻）
      placeOn(activeItem, true);

      items.forEach(item => {
        const enter = () => placeOn(item, false);
        item.addEventListener("pointerenter", enter, { signal });
        item.addEventListener("focusin", enter, { signal });
      });

      // 离开轨道：回到活动项
      track.addEventListener(
        "pointerleave",
        () => placeOn(activeItem, true),
        { signal }
      );

      // 布局/字体变化后重新对齐（药丸跟随实际位置）
      const realign = () => placeOn(activeItem, true);
      window.addEventListener("resize", realign, { signal });
      if (document.fonts?.ready) {
        document.fonts.ready.then(() =>
          requestAnimationFrame(realign)
        );
      }
    });

    // 下拉组开关（桌面 hover + 键盘/点击）
    groups.forEach(group => {
      const trigger = group.querySelector<HTMLElement>(".nav-dropdown-trigger");
      const dropdown = group.querySelector<HTMLElement>(".nav-dropdown");
      if (!trigger || !dropdown) return;

      const closeAll = () =>
        groups.forEach(g => {
          g.classList.remove("is-open");
          g.querySelector(".nav-dropdown-trigger")?.setAttribute(
            "aria-expanded",
            "false"
          );
        });

      const open = () => {
        if (closeTimers.has(group)) {
          window.clearTimeout(closeTimers.get(group));
          closeTimers.delete(group);
        }
        // 关闭其它组
        closeAll();
        group.classList.add("is-open");
        trigger.setAttribute("aria-expanded", "true");
      };
      const scheduleClose = () => {
        // 防悬停间隙：延迟关闭，给鼠标穿过 trigger→下拉的 0.5rem 留时间
        if (closeTimers.has(group)) return;
        const t = window.setTimeout(() => {
          group.classList.remove("is-open");
          trigger.setAttribute("aria-expanded", "false");
          closeTimers.delete(group);
        }, 160);
        closeTimers.set(group, t);
      };
      const closeNow = () => {
        if (closeTimers.has(group)) {
          window.clearTimeout(closeTimers.get(group));
          closeTimers.delete(group);
        }
        group.classList.remove("is-open");
        trigger.setAttribute("aria-expanded", "false");
      };

      group.addEventListener("pointerenter", open, { signal });
      group.addEventListener("pointerleave", scheduleClose, { signal });
      // 点击 toggle（触屏/键盘）
      trigger.addEventListener(
        "click",
        e => {
          e.preventDefault();
          group.classList.contains("is-open") ? closeNow() : open();
        },
        { signal }
      );
      // ESC 关闭
      trigger.addEventListener(
        "keydown",
        e => {
          if (e.key === "Escape") closeNow();
        },
        { signal }
      );
      // 点击下拉项后关闭
      dropdown.querySelectorAll("a").forEach(a =>
        a.addEventListener("click", closeNow, { signal })
      );
      // 下拉内部悬停取消延迟关闭
      dropdown.addEventListener("pointerenter", open, { signal });
    });

    // 点击页面空白处关闭所有下拉
    document.addEventListener(
      "click",
      e => {
        const target = e.target as Node;
        if (!target || !(target instanceof Element)) return;
        if (!target.closest(".nav-menu-item")) {
          groups.forEach(g => g.classList.remove("is-open"));
        }
      },
      { signal }
    );
  }

  // Initial load
  setupScrollPhysics();
  setupMobileNav();
  setupGlideNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", () => {
    setupScrollPhysics();
    setupMobileNav();
    setupGlideNav();
  });
</script>
