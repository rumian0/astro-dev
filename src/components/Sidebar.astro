---
/**
 * Sidebar — 右侧边栏（合并旧站 mingcy.cn 首页 home-grid 左栏 + 右栏）
 * 左侧栏内容：资料卡（头像 / 名字 / 简介 / 快捷导航 / 社交）、今日一言
 * 右侧栏内容：问候时钟、随笔插画（随机图）、站点信息
 * 仅在大屏（lg+）首页显示；移动端由顶部 Header 导航承担。
 */
import Socials from "@/components/Socials.astro";
import IconArchive from "@/assets/icons/IconArchive.svg";
import { buildTocTree, renderTocTree } from "@/utils/tocTree";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

interface Props {
  /** 文章 headings（仅文章页传入，驱动目录卡片；首页不传） */
  headings?: Array<{ depth: number; slug: string; text: string }>;
  /** 是否显示「站点信息」卡片（文章页隐藏，首页保留） */
  showSiteInfo?: boolean;
}

const { headings = [], showSiteInfo = true } = Astro.props;

// 目录卡片（文章页专用；手机端随整个侧边栏隐藏）
const tocTreeHtml =
  headings.length >= 2 ? renderTocTree(buildTocTree(headings)) : "";
const tocTotal = headings.length;

const { pathname } = Astro.url;
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;
const isActive = (path: string) =>
  currentPath === path ||
  currentPath.split("/").filter(p => p.trim())[0] ===
    path.split("/").filter(p => p.trim())[0];

// 头像：旧站使用 mingcy.cn/image/mcy.png；可被 PUBLIC_AVATAR 覆盖
const avatar =
  import.meta.env.PUBLIC_AVATAR || "https://mingcy.cn/image/mcy.png";

// 快捷导航：对齐旧站 4 图标 profile-nav（首页/归档/项目/关于）
const navItems = [
  {
    label: "首页",
    href: "/",
    icon: "home",
  },
  { label: "归档", href: "/archives", icon: "archive" },
  { label: "项目", href: "/projects", icon: "project" },
  { label: "关于", href: "/about", icon: "about" },
];

// ── 站点信息（对齐旧站右栏）──
const siteInfoRows = [
  { label: "构建平台", value: "Astro" },
  { label: "博客版本", value: "v1.0.0" },
  { label: "协议许可", value: "MIT" },
  { label: "站点域名", value: "mingcy.cn" },
];
const techGrid = [
  { name: "Astro", ver: "5+" },
  { name: "TypeScript", ver: "5+" },
  { name: "Tailwind", ver: "4" },
  { name: "Node", ver: "22" },
  { name: "pnpm", ver: "9+" },
];
---

<aside class="home-sidebar hidden lg:block">
  <div class="sidebar-sticky space-y-5">
    {/* ═══ 资料卡（旧站左栏）═══ */}
    <section class="sidebar-card p-5 text-center">
      <div
        class="sidebar-avatar mx-auto size-20 overflow-hidden rounded-xl border border-border/40 bg-foreground/5"
      >
        <img
          src={avatar}
          alt={SITE.author}
          class="size-full object-cover"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
        />
      </div>
      <h2 class="mt-3 text-lg font-bold tracking-tight">
        <span class="relative font-bold">
          <span
            class="absolute -z-10 top-[30%] left-0 h-[40%] w-full -rotate-3 bg-accent/30"
            aria-hidden="true"
          ></span>
          {SITE.author}
        </span>
      </h2>
      <p class="mt-1 text-xs text-foreground/60">{SITE.hero.bio}</p>

      {/* 快捷导航（仿 profile-nav） */}
      <nav class="profile-nav mt-4 flex justify-center gap-2" aria-label="侧边快捷导航">
        {
          navItems.map(item => (
            <a
              href={item.href}
              class:list={[
                "profile-nav-link",
                "flex size-9 items-center justify-center rounded-lg border border-border/30 bg-foreground/[0.03] transition-all hover:-translate-y-0.5 hover:border-accent/40 hover:text-accent",
                { "profile-nav-active": isActive(item.href) },
              ]}
              title={item.label}
              aria-label={item.label}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.icon === "archive" && <IconArchive class="size-5" />}
              {item.icon === "home" && (
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 10.5 12 3l9 7.5"></path>
                  <path d="M5 9.5V21h14V9.5"></path>
                  <path d="M9.5 21v-6h5v6"></path>
                </svg>
              )}
              {item.icon === "project" && (
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path>
                  <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path>
                  <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path>
                  <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
                </svg>
              )}
              {item.icon === "about" && (
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="8" r="4"></circle>
                  <path d="M4 21c0-4 4-6 8-6s8 2 8 6"></path>
                </svg>
              )}
            </a>
          ))
        }
      </nav>

      {/* 社交 */}
      {SOCIALS.length > 0 && (
        <div class="mt-4 flex justify-center">
          <Socials />
        </div>
      )}
    </section>

    {/* ═══ 今日一言（旧站左栏）═══ */}
    <section class="sidebar-card p-5">
      <div class="sidebar-title flex items-center gap-2 text-sm font-bold">
        <svg class="size-4 text-accent/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 21c3 0 7-2 9-5"></path>
          <path d="M14 3.5 20.5 10 9 21l-5-5L14.5 3.5z"></path>
        </svg>
        今日一言
      </div>
      <blockquote class="m-0 mt-2 text-sm leading-relaxed text-foreground/70">
        <span class="mr-1 text-accent">“</span>
        {SITE.hero.yiyan}
        <span class="ml-1 text-accent">”</span>
      </blockquote>
      <p class="mt-2 text-right text-xs text-foreground/50">
        — {SITE.hero.bio}
      </p>
    </section>

    {/* ═══ 文章目录（文章页专用卡片，位于「今日一言」之下）═══ */}
    {tocTreeHtml && (
      <section class="sidebar-card toc-sidebar-card p-4">
        <div class="sidebar-title flex items-center gap-2 text-sm font-bold">
          <svg
            class="size-4 text-accent/70"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="4" y1="6" x2="20" y2="6"></line>
            <line x1="4" y1="12" x2="14" y2="12"></line>
            <line x1="4" y1="18" x2="10" y2="18"></line>
          </svg>
          文章目录
          <span
            class="ml-auto font-firacode text-[0.7rem] font-normal text-foreground/40 tabular-nums"
            aria-hidden="true"
          >
            {String(tocTotal).padStart(2, "0")}
          </span>
        </div>
        <nav class="toc-sidebar-nav mt-3 max-h-[min(44vh,22rem)] overflow-y-auto pr-1">
          <div class="toc-sidebar-tree" set:html={tocTreeHtml}></div>
        </nav>
      </section>
    )}

    {/* ═══ 问候时钟（旧站右栏 GreetingClock）═══ */}
    <section class="sidebar-card p-5 text-center">
      <div class="clock-time font-firacode text-3xl font-bold tracking-tight tabular-nums">
        --:--:--
      </div>
      <p class="mt-2 text-xs text-foreground/60">
        ----年--月--日 · 星期-
      </p>
      <p class="mt-1 text-sm text-accent">…</p>
    </section>

    {/* ═══ 随笔插画（旧站右栏随机图）═══ */}
    <section class="sidebar-card overflow-hidden p-3">
      <img
        src="https://webp.mingcy.cn"
        alt="随笔插画"
        class="h-32 w-full rounded-lg object-cover"
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
      />
    </section>

    {/* ═══ 站点信息（旧站右栏；文章页通过 showSiteInfo 隐藏）═══ */}
    {showSiteInfo && (
      <section class="sidebar-card p-5">
        <div class="sidebar-title flex items-center gap-2 text-sm font-bold">
          <svg class="size-4 text-accent/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 16v-4"></path>
            <path d="M12 8h.01"></path>
          </svg>
          站点信息
        </div>

        <div class="site-info-rows mt-3">
          {siteInfoRows.map(row => (
            <div class="site-info-row">
              <span class="text-foreground/55">{row.label}</span>
              <span class="font-firacode text-accent font-bold">{row.value}</span>
            </div>
          ))}
        </div>

        <div class="tech-grid mt-3 grid grid-cols-2 gap-2">
          {techGrid.map(t => (
            <div class="tech-item rounded-lg border border-border/20 bg-foreground/[0.04] px-3 py-1.5 text-center">
              <span class="block text-xs text-foreground/55">{t.name}</span>
              <b class="font-firacode text-xs text-foreground/85">{t.ver}</b>
            </div>
          ))}
        </div>

        <div class="site-info-row mt-3">
          <span class="text-foreground/55">构建时间</span>
          <span class="font-firacode text-xs text-foreground/60">每次构建自动更新</span>
        </div>

        <button
          id="site-info-collapse"
          type="button"
          class="mt-3 w-full cursor-pointer rounded-lg border border-border/30 bg-foreground/[0.04] py-1.5 text-xs text-foreground/60 transition-colors hover:text-accent"
        >
          收起
        </button>
      </section>
    )}
  </div>
</aside>

<style>
  .home-sidebar {
    position: relative;
  }
  .sidebar-sticky {
    position: sticky;
    top: 6rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .sidebar-card {
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
    background: color-mix(in srgb, var(--foreground) 3%, transparent);
    backdrop-filter: blur(12px) saturate(160%);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
    transition: border-color 0.3s ease;
  }
  .sidebar-card:hover {
    border-color: color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .sidebar-avatar {
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .sidebar-card:hover .sidebar-avatar {
    transform: scale(1.04);
  }
  .profile-nav-link {
    color: var(--foreground);
  }
  .profile-nav-active {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent) !important;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .site-info-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.45rem;
    margin-bottom: 0.45rem;
    border-bottom: 1px dashed color-mix(in srgb, var(--border) 35%, transparent);
    font-size: 0.8125rem;
  }
  .site-info-row:last-of-type {
    border-bottom: 0;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  /* 折叠按钮隐藏行 */
  .site-info-row[data-collapsed="1"],
  .tech-grid[data-collapsed="1"] {
    display: none;
  }
  .sidebar-sticky::-webkit-scrollbar {
    width: 0;
    height: 0;
  }
  /* ═══ 目录卡片（文章页，重构：真实层级缩进 —— 药丸逐级右移 + 分级刻度 + 树枝肘线）═══ */
  .toc-sidebar-tree {
    position: relative;
    --toc-rail: 0.4rem; /* 0 级刻度 x（树主干 x）*/
    --toc-step: 0.8rem; /* 每级缩进步长（侧边栏略窄）*/
  }
  /* 树主干：一条贯穿左缘的细线，锚定整棵树的视觉起点 */
  .toc-sidebar-tree::before {
    content: "";
    position: absolute;
    left: calc(var(--toc-rail) + 1px);
    top: 0.25rem;
    bottom: 0.25rem;
    width: 1px;
    border-radius: 9999px;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--foreground) 9%, transparent) 12%,
      color-mix(in srgb, var(--foreground) 9%, transparent) 88%,
      transparent
    );
    pointer-events: none;
  }
  .toc-sidebar-card .toc-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.5rem 0.28rem
      calc(1.05rem + var(--toc-level) * var(--toc-step));
    border-radius: 0.5rem;
    text-decoration: none;
    color: color-mix(in srgb, var(--foreground) 62%, transparent);
    transition:
      background-color 0.22s ease-out,
      color 0.22s ease-out;
  }
  /* 分级刻度：钉在各自层级 x（0 级在主干上，其余逐级右移成阶梯）*/
  .toc-sidebar-card .toc-row::before {
    content: "";
    position: absolute;
    left: calc(var(--toc-rail) + var(--toc-level) * var(--toc-step));
    top: 50%;
    width: 2px;
    height: 1em;
    transform: translateY(-50%);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--foreground) 16%, transparent);
    transition: background-color 0.22s ease-out;
  }
  /* 树枝肘线：子级行从父级刻度横向连到本级刻度，形成分支 */
  .toc-sidebar-card .toc-node[data-depth="3"] .toc-row::after,
  .toc-sidebar-card .toc-node[data-depth="4"] .toc-row::after,
  .toc-sidebar-card .toc-node[data-depth="5"] .toc-row::after,
  .toc-sidebar-card .toc-node[data-depth="6"] .toc-row::after {
    content: "";
    position: absolute;
    left: calc(var(--toc-rail) + (var(--toc-level) - 1) * var(--toc-step));
    top: 50%;
    width: var(--toc-step);
    height: 1.5px;
    transform: translateY(-50%);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--foreground) 12%, transparent);
    transition: background-color 0.22s ease-out;
  }
  .toc-sidebar-card .toc-text {
    display: inline-block;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: middle;
    font-size: 0.78rem;
    line-height: 1.4;
  }
  .toc-sidebar-card .toc-row:hover {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    color: var(--accent);
  }
  .toc-sidebar-card .toc-row.is-active {
    background: color-mix(in srgb, var(--accent) 11%, transparent);
    color: var(--accent);
  }
  .toc-sidebar-card .toc-row.is-active::before {
    height: 1.2em;
    opacity: 0;
  }
  .toc-sidebar-card .toc-row.is-active::after {
    background: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .toc-sidebar-card .toc-row.is-active .toc-text {
    font-weight: 600;
  }
  .toc-sidebar-card .toc-node.is-ancestor .toc-row {
    color: color-mix(in srgb, var(--accent) 55%, var(--foreground));
  }
  .toc-sidebar-card .toc-node.is-ancestor .toc-row::before {
    background: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .toc-sidebar-card .toc-node.is-ancestor .toc-row::after {
    background: color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .toc-sidebar-card .toc-node[data-depth="2"] .toc-text {
    font-weight: 600;
  }
  .toc-sidebar-card .toc-node[data-depth="3"] .toc-text {
    font-size: 0.74rem;
  }
  .toc-sidebar-card .toc-node[data-depth="4"] .toc-text,
  .toc-sidebar-card .toc-node[data-depth="5"] .toc-text {
    font-size: 0.7rem;
  }
  .toc-sidebar-nav::-webkit-scrollbar {
    width: 3px;
  }
  .toc-sidebar-nav::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--accent) 25%, transparent);
    border-radius: 10px;
  }
  @media (prefers-reduced-motion: reduce) {
    .sidebar-card:hover .sidebar-avatar,
    .profile-nav-link:hover {
      transform: none;
    }
  }
</style>

<script>
  import { initTocHighlight } from "@/scripts/toc-highlight";

  // ═══ 问候时钟（GreetingClock 复刻）═══
  document.addEventListener("astro:page-load", () => {
    const card = document.querySelector(".home-sidebar .clock-time");
    if (!card) return;

    const dateEl = card.nextElementSibling as HTMLElement | null;
    const greetEl = dateEl?.nextElementSibling as HTMLElement | null;

    const WEEKDAYS = ["日", "一", "二", "三", "四", "五", "六"];
    const greetings = [
      { start: 5, text: "早上好，新的一天加油！" },
      { start: 11, text: "中午好，记得吃午饭~" },
      { start: 13, text: "下午好，继续努力！" },
      { start: 18, text: "晚上好，放松一下吧~" },
      { start: 23, text: "夜深了，注意休息~" },
    ];

    const pad = (n: number) => String(n).padStart(2, "0");

    const tick = () => {
      const now = new Date();
      card.textContent = `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
      if (dateEl) {
        dateEl.textContent = `${now.getFullYear()}年${now.getMonth() + 1}月${now.getDate()}日 · 星期${WEEKDAYS[now.getDay()]}`;
      }
      if (greetEl) {
        const h = now.getHours();
        let text = greetings[0].text;
        for (const g of greetings) {
          if (h >= g.start) text = g.text;
        }
        greetEl.textContent = text;
      }
    };

    tick();
    const timer = window.setInterval(tick, 1000);
    document.addEventListener("astro:after-swap", () => window.clearInterval(timer), { once: true });
  });

  // ═══ 站点信息折叠 ═══
  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("site-info-collapse");
    if (!btn) return;
    const toggle = () => {
      const rows = btn
        .closest(".sidebar-card")
        ?.querySelectorAll(".site-info-row, .tech-grid");
      if (!rows || !rows.length) return;
      const collapsed = rows[0]?.getAttribute("data-collapsed") === "1";
      rows.forEach(el => el.setAttribute("data-collapsed", collapsed ? "0" : "1"));
      btn.textContent = collapsed ? "收起" : "展开";
    };
    btn.addEventListener("click", toggle);
  });

  // ═══ 目录卡片高亮（复用 TocButton 的高亮引擎）═══
  let tocAc: AbortController | null = null;
  document.addEventListener("astro:page-load", () => {
    tocAc?.abort();
    const card = document.querySelector(".toc-sidebar-card");
    const list = card?.querySelector<HTMLElement>(".toc-sidebar-nav");
    const tree = card?.querySelector<HTMLElement>(".toc-sidebar-tree");
    if (!list || !tree) return;
    if (list.dataset.tocInited === "1") return;
    list.dataset.tocInited = "1";
    tocAc = new AbortController();
    initTocHighlight({
      list,
      tree,
      signal: tocAc.signal,
    });
  });
</script>
