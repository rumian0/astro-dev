---
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Datetime from "@/components/Datetime.astro";
import IconGallery from "@/assets/icons/IconGallery.svg";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";

// Remote live-photo manifest: { cover, video } (split mode) or
// { src, live:"motion" } (Google Motion Photo, mp4 embedded in jpg).
// Kept under src/data/gallery-manifests/ so the galleries content
// collection doesn't pick the JSON up as a data entry.
type RemoteImage =
  | { alt: string; width: number; height: number; cover: string; video: string }
  | { alt: string; width: number; height: number; src: string; live: "motion" };
type RemoteManifest = { images: RemoteImage[] };

type LiveImage = {
  src: string;
  alt: string;
  width: number;
  height: number;
  live: true;
  cover?: string;
  video?: string;
  motion?: string;
};

export async function getStaticPaths() {
  if (!SITE.showGalleries) return [];

  const galleries = await getCollection("galleries", ({ data }) => !data.draft);
  return galleries.map(gallery => ({
    params: {
      gallery: gallery.id
        .replace(/\/index\.(md|mdx)$/, "")
        .replace(/\.(md|mdx)$/, ""),
    },
    props: { entry: gallery },
  }));
}

const { entry } = Astro.props;
const { gallery: slug } = Astro.params;
const { title, description, pubDatetime, coverImage, tags } = entry.data;

// Static gallery images (Astro Assets pipeline)
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/data/galleries/**/*.{jpg,jpeg,png,webp,avif,gif,JPG,JPEG,PNG,WEBP}",
  { eager: true }
);

// Remote live-photo manifests
const manifests = import.meta.glob("/src/data/gallery-manifests/*.json", {
  eager: true,
}) as Record<string, RemoteManifest | { default: RemoteManifest }>;

type StaticImg = { src: ImageMetadata; alt: string; filename: string };

function filenameToAlt(filename: string): string {
  return (
    filename
      .replace(/\.[^.]+$/, "")
      .replace(/^\d+[-_]?/, "")
      .replace(/[-_]/g, " ")
      .replace(/\b\w/g, c => c.toUpperCase())
      .trim() || title
  );
}

// Match the manifest case-insensitively: Astro may lowercase the slug param,
// while the manifest filename keeps its original casing (e.g. Love-eyes.json).
const manifestMod = (() => {
  const target = String(slug).toLowerCase();
  const hit = Object.entries(manifests).find(([k]) =>
    k.split("/").pop()!.replace(/\.json$/i, "").toLowerCase() === target
  );
  return hit ? hit[1] : undefined;
})();
const liveImages: LiveImage[] = (() => {
  if (!manifestMod) return [];
  const m = "default" in manifestMod ? manifestMod.default : manifestMod;
  return m.images.map(img => {
    const alt = img.alt || title;
    if ("cover" in img) {
      return {
        src: img.cover,
        alt,
        width: img.width,
        height: img.height,
        live: true,
        cover: img.cover,
        video: img.video,
      };
    }
    return {
      src: img.src,
      alt,
      width: img.width,
      height: img.height,
      live: true,
      motion: img.src,
    };
  });
})();

const isLive = liveImages.length > 0;

const staticImages: StaticImg[] = Object.entries(allImages)
  .filter(
    ([path]) =>
      path.startsWith(`/src/data/galleries/${slug}/`) && !path.includes("index")
  )
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const filename = path.split("/").pop() ?? "";
    return { src: mod.default, alt: filenameToAlt(filename), filename };
  });

const images = isLive ? liveImages : staticImages;
const photoCount = images.length;

// If the frontmatter has coverImage, include it at the beginning if not in list
const hasCoverInFolder = coverImage
  ? staticImages.some(img => img.src.src === coverImage.src)
  : false;

const coverImageSrc = coverImage
  ? new URL(coverImage.src, Astro.url.origin).href
  : images.length > 0
    ? isLive
      ? new URL(liveImages[0].src, Astro.url.origin).href
      : new URL(staticImages[0].src.src, Astro.url.origin).href
    : undefined;

// Schema.org ImageGallery
const gallerySchema = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: title,
  description: description,
  url: new URL(Astro.url.pathname, SITE.website).toString(),
  ...(coverImageSrc && { image: coverImageSrc }),
  creator: {
    "@type": "Person",
    name: SITE.author,
    ...(SITE.profile && { url: SITE.profile }),
  },
  numberOfItems: photoCount,
};
---

<Layout
  title={`${title} | Galleries | ${SITE.title}`}
  description={description}
  structuredData={gallerySchema}
>
  <Header />
  {SITE.showBackButton && <Breadcrumb withBackButton />}
  <main
    id="main-content"
    class:list={["relative app-layout pb-16", { "mt-8": !SITE.showBackButton }]}
  >
    <!-- Gallery header -->
    <header class="mb-14 border-b border-border/10 pb-10 sm:pb-14 pt-8">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <div class="max-w-3xl">
          <div class="mb-5 inline-flex items-center gap-2 text-accent">
            <IconGallery class="size-5" />
            <span class="font-firacode text-xs font-bold tracking-[0.2em] uppercase opacity-90">
              Collection // {photoCount} {photoCount === 1 ? "photo" : "photos"}
            </span>
          </div>

          <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-5xl xl:text-6xl text-foreground" style={{ viewTransitionName: slugifyStr(String(title).replaceAll(".", "-")) }}>
            {title}
          </h1>

          {description && (
            <p class="mt-6 text-lg sm:text-xl leading-relaxed text-foreground/60">{description}</p>
          )}
        </div>

        <div class="flex flex-col gap-4 md:items-end w-full md:w-auto shrink-0 md:pb-2">
          <div class="inline-flex items-center gap-2 text-foreground/40 font-firacode text-sm">
            <svg class="size-4 opacity-50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <Datetime pubDatetime={pubDatetime} class="[&>svg]:hidden mb-0" />
          </div>

          {tags.length > 0 && (
            <div class="flex flex-wrap gap-x-4 gap-y-2 text-sm md:justify-end mt-2 md:mt-0">
              {tags.map(tag => (
                <a
                  href={`/tags/${slugifyStr(tag)}/`}
                  class="group relative inline-flex items-center text-foreground/50 transition-colors duration-300 hover:text-accent font-firacode"
                >
                  <span class="mr-1 text-accent/40 transition-colors duration-300 group-hover:text-accent">#</span>
                  {tag}
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- Large cover (static galleries only, if defined and not in folder) -->
    {
      !isLive && coverImage && !hasCoverInFolder && (
        <div class="mb-8 overflow-hidden rounded-2xl">
          <Image
            src={coverImage}
            alt={title}
            class="max-h-[60vh] w-full object-cover"
            loading="eager"
            widths={[800, 1200, 1600]}
            sizes="(max-width: 1200px) 100vw, 1200px"
          />
        </div>
      )
    }

    {/* ── Live gallery: CSS-column waterfall + Fancybox lightbox ── */}
    {
      isLive ? (
        <div class="gallery-waterfall" id="gallery-waterfall">
          {liveImages.map(img => (
            <a
              href={img.src}
              class="gallery-live-item gallery-live"
              data-fancybox="gallery"
              data-caption={img.alt}
              data-motion={img.motion}
              data-cover={img.cover}
              data-video={img.video}
              aria-label={`View image: ${img.alt}`}
            >
              <img
                src={img.src}
                alt={img.alt}
                width={img.width}
                height={img.height}
                class="gallery-img"
                data-live-motion={img.motion}
                data-live-video={img.video}
                loading="lazy"
                decoding="async"
              />
              <div class="gallery-overlay">
                <span class="gallery-alt">{img.alt}</span>
              </div>
            </a>
          ))}
        </div>
      ) : images.length > 0 ? (
        /* ── Static gallery: grid + built-in <dialog> lightbox ── */
        <ul
          class="gallery-grid mt-6"
          id="gallery-grid"
          role="list"
          aria-label={`Images of ${title}`}
        >
          {staticImages.map((img, idx) => (
            <li>
              <button
                class="gallery-item group"
                data-index={idx}
                aria-label={`View image: ${img.alt}`}
                type="button"
              >
                <Image
                  src={img.src}
                  alt={img.alt}
                  class="gallery-img"
                  loading={idx < 6 ? "eager" : "lazy"}
                  widths={[400, 800]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                />
                <div class="gallery-item-overlay">
                  <span class="gallery-item-alt">{img.alt}</span>
                </div>
              </button>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-12 text-center text-foreground/50 italic">
          This gallery has no images yet.
        </p>
      )
    }
  </main>
  <Footer />
</Layout>

<!-- Built-in lightbox dialog (static galleries only) -->
{
  !isLive && (
    <dialog id="lightbox" class="lightbox" aria-label="Image viewer" aria-modal="true">
      <div class="lightbox-layout">
        <div class="lightbox-topbar">
          <span id="lightbox-counter" class="lightbox-counter font-firacode"></span>
          <button class="lightbox-btn" id="lightbox-close" aria-label="Close" title="Close (Esc)" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>

        <div class="lightbox-main">
          <button class="lightbox-btn lightbox-nav" id="lightbox-prev" aria-label="Previous" title="Previous (Left Arrow)" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>

          <div class="lightbox-figure">
            <img id="lightbox-img" src="" alt="" class="lightbox-image" />
            <p id="lightbox-caption" class="lightbox-caption text-foreground/80"></p>
          </div>

          <button class="lightbox-btn lightbox-nav" id="lightbox-next" aria-label="Next" title="Next (Right Arrow)" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>
    </dialog>
  )
}

<script>
  // Built-in lightbox for STATIC galleries only. Lives on #gallery-grid;
  // live galleries use Fancybox (driven by src/scripts/live-gallery.ts) and
  // render no #gallery-grid, so this no-ops there.
  function initGallery() {
    const grid = document.getElementById("gallery-grid");
    const lightbox = document.getElementById(
      "lightbox"
    ) as HTMLDialogElement | null;
    if (!grid || !lightbox) return;

    const lb = lightbox;

    const items = Array.from(
      grid.querySelectorAll<HTMLButtonElement>(".gallery-item")
    );
    const lightboxImg = document.getElementById(
      "lightbox-img"
    ) as HTMLImageElement;
    const lightboxCaption = document.getElementById(
      "lightbox-caption"
    ) as HTMLElement;
    const lightboxCounter = document.getElementById(
      "lightbox-counter"
    ) as HTMLElement;
    const closeBtn = document.getElementById("lightbox-close");
    const prevBtn = document.getElementById("lightbox-prev");
    const nextBtn = document.getElementById("lightbox-next");

    let current = 0;

    function open(idx: number) {
      current = Math.max(0, Math.min(idx, items.length - 1));
      const btn = items[current];
      const img = btn.querySelector("img");
      if (!img) return;
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightboxCaption.textContent = img.alt;
      lightboxCounter.textContent = `${current + 1} / ${items.length}`;

      if (prevBtn) prevBtn.style.visibility = current === 0 ? "hidden" : "visible";
      if (nextBtn) nextBtn.style.visibility = current === items.length - 1 ? "hidden" : "visible";

      lb.showModal();
      document.body.style.overflow = "hidden";
    }

    function close() {
      lb.close();
      document.body.style.overflow = "";
    }

    items.forEach((btn, idx) => {
      btn.addEventListener("click", () => open(idx));
    });

    closeBtn?.addEventListener("click", close);
    prevBtn?.addEventListener("click", () => open(current - 1));
    nextBtn?.addEventListener("click", () => open(current + 1));

    lightbox.addEventListener("click", e => {
      const target = e.target as HTMLElement;
      if (!target.closest("img, button, .lightbox-caption, .lightbox-counter")) {
        close();
      }
    });

    document.addEventListener("keydown", e => {
      if (!lb.open) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") open(current - 1);
      if (e.key === "ArrowRight") open(current + 1);
    });
  }

  initGallery();
  document.addEventListener("astro:after-swap", initGallery);
</script>

<style>
  /* ── Live gallery: CSS-column waterfall ── */
  .gallery-waterfall {
    column-count: 3;
    column-gap: 1rem;
    padding: 0;
    margin: 0;
  }
  @media (max-width: 768px) { .gallery-waterfall { column-count: 2; } }
  @media (max-width: 480px) { .gallery-waterfall { column-count: 1; } }

  .gallery-live-item {
    position: relative;
    display: block;
    width: 100%;
    margin: 0 0 1rem;
    padding: 0;
    border-radius: 0.75rem;
    overflow: hidden;
    cursor: zoom-in;
    background: color-mix(in srgb, var(--foreground) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 25%, transparent);
    transition: border-color 0.2s, box-shadow 0.2s;
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    page-break-inside: avoid;
  }
  .gallery-live-item:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    box-shadow: 0 4px 24px color-mix(in srgb, var(--accent) 12%, transparent);
  }
  /* live item loading shimmer (until Heo unpacks the cover) */
  .gallery-live-item.gallery-live {
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--foreground) 8%, transparent) 25%,
      color-mix(in srgb, var(--foreground) 16%, transparent) 37%,
      color-mix(in srgb, var(--foreground) 8%, transparent) 63%
    );
    background-size: 400% 100%;
    animation: gallery-shimmer 1.8s ease infinite;
  }
  @keyframes gallery-shimmer {
    0% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-live-item.gallery-live { animation: none; }
  }

  /* ── Static gallery: grid (unchanged from original) ── */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  @media (min-width: 640px) {
    .gallery-grid { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  }
  @media (min-width: 1024px) {
    .gallery-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .gallery-item {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 0.75rem;
    cursor: zoom-in;
    background: color-mix(in srgb, var(--foreground) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 25%, transparent);
    transition: border-color 0.2s, box-shadow 0.2s;
    padding: 0;
  }
  .gallery-item:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    box-shadow: 0 4px 24px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .gallery-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    transition: transform 0.4s ease;
    display: block;
  }
  .gallery-live-item .gallery-img { height: auto; object-fit: contain; }
  .gallery-item .gallery-img { height: 100%; }
  .gallery-item:hover .gallery-img { transform: scale(1.05); }

  .gallery-overlay,
  .gallery-item-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 0.75rem;
    background: linear-gradient(
      to top,
      color-mix(in srgb, black 60%, transparent) 0%,
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.3s;
  }
  .gallery-live-item:hover .gallery-overlay,
  .gallery-item:hover .gallery-item-overlay,
  .gallery-item:focus-visible .gallery-item-overlay { opacity: 1; }
  .gallery-alt,
  .gallery-item-alt {
    font-size: 0.75rem;
    color: white;
    line-height: 1.3;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  /* ── Built-in lightbox (static galleries) ── */
  .lightbox {
    position: fixed;
    inset: 0;
    max-width: 100vw;
    max-height: 100dvh;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background: var(--background);
    border: none;
    z-index: 100;
    color: var(--foreground);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
  }
  .lightbox[open] { opacity: 1; }
  .lightbox::backdrop { background: transparent; }
  .lightbox:not([open]) { display: none; }
  .lightbox-layout { width: 100%; height: 100%; display: flex; flex-direction: column; }
  .lightbox-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    flex-shrink: 0;
  }
  .lightbox-counter {
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--foreground) 50%, transparent);
  }
  .lightbox-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem 1.5rem;
    min-height: 0;
    gap: 1.5rem;
  }
  .lightbox-figure {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: 100%;
    gap: 1.25rem;
  }
  .lightbox-image {
    max-width: 100%;
    max-height: calc(100dvh - 10rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    will-change: transform;
    transform: translateZ(0);
  }
  .lightbox-caption {
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--foreground) 80%, transparent);
    text-align: center;
    max-width: 50ch;
    line-height: 1.5;
    margin: 0;
    font-weight: 300;
  }
  .lightbox-btn {
    background: color-mix(in srgb, var(--foreground) 3%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 15%, transparent);
    color: color-mix(in srgb, var(--foreground) 70%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0.75rem;
    border-radius: 50%;
    backdrop-filter: blur(4px);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--background) 50%, transparent);
  }
  .lightbox-btn:hover {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent);
    transform: scale(1.05) translateY(-2px);
    box-shadow: 0 8px 24px -4px color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .lightbox-nav { flex-shrink: 0; }
  @media (max-width: 640px) {
    .lightbox-main { padding: 0 0 1rem 0; gap: 0; position: relative; }
    .lightbox-nav { position: absolute; top: 50%; transform: translateY(-50%); padding: 1rem 0.5rem; }
    .lightbox-nav:hover { transform: translateY(-50%) scale(1.1); }
    #lightbox-prev { left: 0; }
    #lightbox-next { right: 0; }
    .lightbox-image { max-height: calc(100dvh - 8rem); }
  }
</style>

<!-- Live lightbox player styles (global: Fancybox & HeoLivePhoto DOM have no
     scoped astro-cid attribute). Overrides plugin/Fancybox inline styles. -->
<style is:global>
  /* HeoLivePhoto wraps the live img in an anonymous <span>; force block/full-width */
  .gallery-live-item > span {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    max-width: 100% !important;
    overflow: hidden !important;
    line-height: 0;
  }
  .gallery-live-item .gallery-img {
    width: 100% !important;
    height: auto !important;
    max-width: 100% !important;
    object-fit: contain !important;
    transition: transform 0.4s ease, opacity 0.3s ease !important;
  }
  .gallery-live-item .gallery-overlay { z-index: 3; }

  /* Fancybox lightbox live player (injected at Carousel.contentReady) */
  .lp-player {
    position: relative;
    display: block;
    margin: 0 auto;
    line-height: 0;
    background: #000;
    min-width: 220px;
    min-height: 140px;
  }
  .lp-cover {
    display: block;
    max-width: min(92vw, 1280px);
    max-height: min(86vh, 980px);
    width: auto;
    height: auto;
    object-fit: contain;
    margin: 0;
    border: 0;
    animation: lp-kenburns 8s ease-out forwards;
    transform-origin: center center;
  }
  @keyframes lp-kenburns {
    0% { transform: scale(1.02); }
    100% { transform: scale(1.12); }
  }
  .lp-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    margin: 0;
    border: 0;
    background: #000;
    opacity: 1;
    transition: opacity 0.25s ease;
  }
  .lp-video.is-waiting { opacity: 0; }
  .lp-spin {
    position: absolute;
    left: 50%; top: 50%;
    width: 34px; height: 34px;
    margin: -17px 0 0 -17px;
