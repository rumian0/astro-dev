---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { SITE } from "@/config";
import { slugifyStr } from "@/utils/slugify";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: SITE.author,
    description: SITE.hero.description,
    alternateName: SITE.hero.bio,
    ...(SITE.profile && { url: SITE.profile }),
  },
};

const skills = [
  { name: "HTML", value: 90 },
  { name: "CSS", value: 85 },
  { name: "JavaScript", value: 80 },
  { name: "Git", value: 75 },
  { name: "TypeScript", value: 70 },
  { name: "Python", value: 65 },
];

const timeline = [
  {
    date: "2007-03-29",
    title: "出生",
    desc: "新疆乌鲁木齐",
  },
  {
    date: "2012",
    title: "第一次接触电脑",
    desc: "第一次摸电脑，两个指头敲文字",
  },
  {
    date: "2020",
    title: "开始编程之旅",
    desc: "因为性格问题，我开始从编程中寻求快乐",
  },
  {
    date: "2022",
    title: "编程转折时间",
    desc: "入门第一门语言是易语言，之后又想做网页，学习了 HTML",
  },
  {
    date: "2023-01-21",
    title: "博客建站日期",
    desc: "第一次用免费虚拟主机，使用 WP 作为博客框架",
  },
  {
    date: "2024-01-21",
    title: "博客迁移日期",
    desc: "购买了 mingcy.cn 的域名，使用 Hexo 作为站点",
  },
  {
    date: "2025",
    title: "持续学习与分享",
    desc: "网络安全方向学习，撰写技术文章",
  },
  {
    date: "2026",
    title: "博客升级",
    desc: "迁移到 Astro，全新的体验",
  },
];

const games = [
  { name: "香肠派对", note: "单四 KD: 9.9" },
  { name: "极品飞车", note: "单排 车王段位" },
  { name: "光遇", note: "跑图大师" },
];

const tags = [
  "数码科技",
  "编程技术",
  "开源",
  "生活",
  "音乐",
  "分享",
  "日常",
];
---

<Layout
  title={`关于 | ${SITE.title}`}
  description={`${SITE.author} — ${SITE.hero.description}。${SITE.hero.bio}`}
  structuredData={structuredData}
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout relative z-10 pb-16">
    <!-- ═══════ Hero ═══════ -->
    <section class="about-hero" data-about-hero>
      <div class="aurora-orb aurora-orb-1"></div>
      <div class="aurora-orb aurora-orb-2"></div>
      <div class="aurora-orb aurora-orb-3"></div>
      <div class="aurora-mouse" data-about-mouse></div>

      <div class="hero-content">
        <div class="avatar-ring">
          <div class="avatar-glow"></div>
          <div class="avatar-inner">
            <img
              src="https://mingcy.cn/image/mcy.png"
              alt={`${SITE.author} 的头像`}
              class="avatar-img"
              width="160"
              height="160"
              decoding="async"
            />
          </div>
        </div>

        <h1 class="hero-title">
          <span class="greeting">Hi, I'm</span>
          <span class="name-glow">{SITE.author}</span>
        </h1>
        <p class="hero-bio">{SITE.hero.bio}</p>
        <p class="hero-desc">{SITE.hero.description}</p>

        <div class="hero-badges">
          <span class="badge" data-badge>INFJ-T</span>
          <span class="badge" data-badge>学生</span>
          <span class="badge" data-badge>网络安全爱好者</span>
        </div>

        <blockquote class="hero-quote">
          「 {SITE.hero.yiyan} 」
        </blockquote>

        <div class="hero-socials">
          {
            SITE.profile && (
              <a
                href={SITE.profile}
                target="_blank"
                rel="noopener noreferrer"
                class="hero-social-btn"
              >
                GitHub
              </a>
            )
          }
          <a href="/rss.xml" class="hero-social-btn">RSS</a>
          <a href="/archives" class="hero-social-btn">归档</a>
        </div>
      </div>
    </section>

    <!-- ═══════ 技能 ═══════ -->
    <section class="about-section glass-panel">
      <h2 class="section-title">
        <span class="section-icon" aria-hidden="true">✦</span>
        技能
      </h2>
      <div class="skills-grid">
        {
          skills.map(skill => (
            <div class="skill-item" data-skill={skill.value}>
              <div class="skill-meta">
                <span class="skill-name">{skill.name}</span>
                <span class="skill-value">{skill.value}%</span>
              </div>
              <div class="skill-track">
                <div
                  class="skill-bar"
                  style={`--target:${skill.value}%`}
                />
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ═══════ 生涯时间线 ═══════ -->
    <section class="about-section glass-panel">
      <h2 class="section-title">
        <span class="section-icon" aria-hidden="true">✦</span>
        生涯
      </h2>
      <ol class="timeline">
        {
          timeline.map(item => (
            <li class="timeline-item">
              <div class="timeline-dot" aria-hidden="true" />
              <div class="timeline-card">
                <time class="timeline-date">{item.date}</time>
                <h3 class="timeline-title">{item.title}</h3>
                <p class="timeline-desc">{item.desc}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ═══════ 游戏 & 标签 ═══════ -->
    <div class="about-grid-2">
      <section class="about-section glass-panel">
        <h2 class="section-title">
          <span class="section-icon" aria-hidden="true">✦</span>
          游戏
        </h2>
        <ul class="game-list">
          {
            games.map(game => (
              <li class="game-item">
                <span class="game-name">{game.name}</span>
                <span class="game-note">{game.note}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="about-section glass-panel">
        <h2 class="section-title">
          <span class="section-icon" aria-hidden="true">✦</span>
          标签
        </h2>
        <ul class="tag-cloud">
          {
          tags.map(tag => (
            <li>
              <a href={`/tags/${slugifyStr(tag)}/`} class="tag-pill">
                {tag}
              </a>
            </li>
          ))
          }
        </ul>
      </section>
    </div>

    <!-- ═══════ 关于本站 ═══════ -->
    <section class="about-section glass-panel">
      <h2 class="section-title">
        <span class="section-icon" aria-hidden="true">✦</span>
        关于本站
      </h2>
      <div class="about-blog prose-app">
        <p>
          这里是 <strong>{SITE.author}</strong> 的个人博客，
          记录编程学习、网络安全折腾与生活点滴。茶香四溢，编程世界。
        </p>
        <p>
          本站基于 <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a>
          构建，托管于
          <a href="https://cloud.tencent.com/product/teo" target="_blank" rel="noopener noreferrer">EdgeOne</a>
          ，主题源自
          <a href="https://github.com/0xdres/astro-devosfera" target="_blank" rel="noopener noreferrer">Devosfera</a>
          并深度定制。
        </p>
        <p>
          有问题欢迎通过页脚社交链接联系我，也可以先看看
          <a href="/posts/">文章归档</a>。
        </p>
      </div>
    </section>

    <!-- ═══════ 随机一图（图库） ═══════ -->
    <section class="about-section about-random glass-panel">
      <h2 class="section-title">
        <span class="section-icon" aria-hidden="true">✦</span>
        随机一图
      </h2>
      <div class="random-frame">
        <img
          src={SITE.background.image}
          alt="来自图库的随机照片"
          class="random-img"
          loading="lazy"
          decoding="async"
          width="1200"
          height="675"
        />
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  let aboutCleanup: AbortController | null = null;

  document.addEventListener("astro:page-load", () => {
    if (aboutCleanup) aboutCleanup.abort();
    aboutCleanup = new AbortController();
    const { signal } = aboutCleanup;

    const hero = document.querySelector("[data-about-hero]") as HTMLElement | null;
    const mouseOrb = document.querySelector("[data-about-mouse]") as HTMLElement | null;

    // 降低动效偏好时跳过鼠标跟随
    const allowMotion = !window.matchMedia(
      "(pointer: coarse), (prefers-reduced-motion: reduce)"
    ).matches;

    if (hero && mouseOrb && allowMotion) {
      let raf = 0;
      hero.addEventListener(
        "mousemove",
        e => {
          if (raf) return;
          raf = requestAnimationFrame(() => {
            const rect = hero.getBoundingClientRect();
            mouseOrb.style.setProperty("--mx", `${e.clientX - rect.left}px`);
            mouseOrb.style.setProperty("--my", `${e.clientY - rect.top}px`);
            mouseOrb.style.opacity = "1";
            raf = 0;
          });
        },
        { signal, passive: true }
      );

      hero.addEventListener(
        "mouseleave",
        () => {
          mouseOrb.style.opacity = "0";
        },
        { signal }
      );
    }

    // Badge hover glow
    document.querySelectorAll<HTMLElement>("[data-badge]").forEach(badge => {
      badge.addEventListener(
        "mousemove",
        e => {
          requestAnimationFrame(() => {
            const rect = badge.getBoundingClientRect();
            badge.style.setProperty("--bx", `${e.clientX - rect.left}px`);
            badge.style.setProperty("--by", `${e.clientY - rect.top}px`);
          });
        },
        { signal, passive: true }
      );
    });

    // 技能条入场动画
    const bars = document.querySelectorAll<HTMLElement>(".skill-bar");
    const fill = (bar: HTMLElement) => {
      bar.style.width = getComputedStyle(bar).getPropertyValue("--target") || "0%";
    };
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              fill(entry.target as HTMLElement);
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.35 }
      );
      bars.forEach(bar => io.observe(bar));
      document.addEventListener(
        "astro:before-swap",
        () => io.disconnect(),
        { once: true, signal }
      );
    } else {
      bars.forEach(fill);
    }
  });
</script>

<style>
  /* ─── Hero ─── */
  .about-hero {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
    padding: 3rem 1.5rem;
    margin-bottom: 2rem;
    background: color-mix(in srgb, var(--background) 55%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 14%, transparent);
    box-shadow: 0 16px 48px -20px rgb(0 0 0 / 0.15);
  }

  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .about-hero {
      backdrop-filter: blur(16px) saturate(140%);
      -webkit-backdrop-filter: blur(16px) saturate(140%);
    }
  }

  @media (min-width: 640px) {
    .about-hero {
      padding: 3.5rem 2.5rem;
    }
  }

  .aurora-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
    will-change: transform;
  }

  .aurora-orb-1 {
    width: 350px;
    height: 350px;
    top: -40%;
    left: -15%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--accent) 25%, transparent),
      transparent 70%
    );
    animation: orb-1 7s ease-in-out infinite alternate;
  }

  .aurora-orb-2 {
    width: 280px;
    height: 280px;
    top: 0%;
    right: -10%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--border) 22%, transparent),
      transparent 70%
    );
    animation: orb-2 9s ease-in-out infinite alternate;
  }

  .aurora-orb-3 {
    width: 220px;
    height: 220px;
    bottom: -25%;
    left: 35%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--accent) 15%, transparent),
      transparent 70%
    );
    animation: orb-3 11s ease-in-out infinite alternate;
  }

  @keyframes orb-1 {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(50px, 30px) scale(1.25); }
  }
  @keyframes orb-2 {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(-40px, 35px) scale(1.2); }
  }
  @keyframes orb-3 {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(25px, -30px) scale(1.15); }
  }

  .aurora-mouse {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--accent) 20%, transparent),
      color-mix(in srgb, var(--border) 10%, transparent) 35%,
      transparent 70%
    );
    filter: blur(50px);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    transform: translate(
      calc(var(--mx, 0px) - 200px),
      calc(var(--my, 0px) - 200px)
    );
    will-change: transform;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora-orb,
    .aurora-mouse {
      animation: none !important;
      will-change: auto;
    }
  }

  .hero-content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }

  .avatar-ring {
    position: relative;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    padding: 3px;
    background: conic-gradient(
      from 0deg,
      var(--accent),
      var(--border),
      var(--accent),
      var(--border),
      var(--accent)
    );
    animation: ring-spin 8s linear infinite;
  }

  @keyframes ring-spin {
    to { transform: rotate(360deg); }
  }

  .avatar-glow {
    position: absolute;
    inset: -12px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--accent) 28%, transparent),
      transparent 70%
    );
    animation: pulse-glow 3s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 0.65; transform: scale(1.12); }
  }

  .avatar-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--background);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .greeting {
    font-size: 1rem;
    opacity: 0.7;
  }

  .name-glow {
    font-size: 2rem;
    font-weight: 800;
    background: linear-gradient(
      135deg,
      var(--foreground) 30%,
      var(--accent)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(
      0 0 25px color-mix(in srgb, var(--accent) 30%, transparent)
    );
  }

  @media (min-width: 640px) {
    .name-glow { font-size: 2.5rem; }
  }

  .hero-bio {
    font-size: 1.125rem;
    font-weight: 500;
    opacity: 0.9;
  }

  .hero-desc {
    font-size: 0.95rem;
    opacity: 0.65;
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .badge {
    position: relative;
    overflow: hidden;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--foreground);
    background: color-mix(in srgb, var(--foreground) 4%, var(--background));
    border: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
    cursor: default;
  }

  .badge::before {
    content: "";
    position: absolute;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--accent) 35%, transparent),
      transparent 70%
    );
    filter: blur(15px);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    transform: translate(
      calc(var(--bx, 50%) - 40px),
      calc(var(--by, 50%) - 40px)
    );
  }

  .badge:hover::before { opacity: 1; }

  .hero-quote {
    margin-top: 0.75rem;
    padding: 0.75rem 1.25rem;
    border-left: 3px solid var(--accent);
    border-radius: 0 0.75rem 0.75rem 0;
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    font-family: var(--font-sriracha), var(--font-app);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--foreground);
    opacity: 0.9;
  }

  .hero-socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .hero-social-btn {
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
    background: color-mix(in srgb, var(--muted) 20%, transparent);
    font-family: var(--font-firacode), monospace;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--foreground);
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .hero-social-btn:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    transform: translateY(-1px);
  }

  /* ─── Sections ─── */
  .glass-panel {
    position: relative;
    border-radius: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--border) 30%, transparent);
    background: color-mix(in srgb, var(--background) 62%, transparent);
    padding: 1.5rem 1.25rem;
    margin-bottom: 1.25rem;
  }

  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .glass-panel {
      backdrop-filter: blur(12px) saturate(130%);
      -webkit-backdrop-filter: blur(12px) saturate(130%);
    }
  }

  @media (min-width: 640px) {
    .glass-panel {
      padding: 1.75rem 1.75rem;
    }
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    letter-spacing: 0.04em;
  }

  .section-icon {
    color: var(--accent);
    font-size: 0.9rem;
  }

  /* ─── Skills ─── */
  .skills-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .skills-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.1rem 1.75rem;
    }
  }

  .skill-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.4rem;
    font-size: 0.875rem;
  }

  .skill-name {
    font-weight: 600;
  }

  .skill-value {
    font-family: var(--font-firacode), monospace;
    color: var(--accent);
    font-size: 0.8rem;
  }

  .skill-track {
    height: 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--muted) 35%, transparent);
    overflow: hidden;
  }

  .skill-bar {
    height: 100%;
    width: 0%;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--accent) 70%, transparent),
      var(--accent)
    );
    box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 40%, transparent);
    transition: width 1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-bar {
      transition: none;
    }
  }

  /* ─── Timeline ─── */
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 7px;
    top: 6px;
    bottom: 6px;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--accent),
      color-mix(in srgb, var(--accent) 20%, transparent)
    );
    border-radius: 2px;
  }

  .timeline-item {
    position: relative;
    padding-left: 1.75rem;
  }

  .timeline-dot {
    position: absolute;
    left: 0;
    top: 0.7rem;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: var(--background);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 15%, transparent);
  }

  .timeline-card {
