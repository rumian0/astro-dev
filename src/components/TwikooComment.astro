---
/**
 * TwikooComment — 评论区组件（自动加载，无需点击展开）
 * 自建服务：twikoo.mingcy.cn
 *
 * - 自动加载：astro:page-load 触发即加载，不再需要「展开评论区」按钮
 * - 多 CDN 回退：npmmirror → staticfile → jsdelivr → unpkg
 *   （原方案只用 jsdelivr，国内经常被墙/超时导致加载失败）
 * - 自适应主题：监听 html[data-theme] 切换与 storage 事件，重刷配色
 * - View Transitions 兼容：每次 page-load 按当前 path 重新挂载（幂等）
 */
import { SITE } from "@/config";

const twikoo = SITE.twikoo;
---

{twikoo?.envId && (
  <section
    id="comments"
    class="twikoo-section mt-12"
    data-pagefind-ignore
    data-env-id={twikoo.envId}
    aria-label="Comments"
  >
    <div id="twikoo-container" class="twikoo-container">
      <!-- 加载占位 -->
      <div class="tk-loading" data-tk-loading>
        <span class="tk-loading-ring"></span>
        <span>正在加载评论…</span>
      </div>
      <!-- Twikoo 挂载点 -->
      <div id="twikoo-comment" class="tk-mount"></div>
    </div>
  </section>
)}

<script>
  // ═══ 自动加载 + 多 CDN 回退 ═══
  // 顺序：国内可达的优先（npmmirror / staticfile），jsdelivr/unpkg 兜底
  const CDN_LIST = [
    "https://registry.npmmirror.com/twikoo/1.6.23/files/dist/twikoo.min.js",
    "https://cdn.staticfile.net/twikoo/1.6.23/twikoo.min.js",
    "https://cdn.jsdelivr.net/npm/twikoo@1.6.23/dist/twikoo.min.js",
    "https://unpkg.com/twikoo@1.6.23/dist/twikoo.min.js",
  ];

  function loadTwikooScript(onReady: () => void, onFail: () => void) {
    // 已加载 / 已有成功标记的脚本
    if ((window as any).Twikoo) {
      onReady();
      return;
    }
    const ok = document.querySelector<HTMLScriptElement>(
      "script[data-twikoo][data-ok]"
    );
    if (ok) {
      onReady();
      return;
    }

    // 已有正在加载的脚本 → 等它完成
    const pending = document.querySelector<HTMLScriptElement>(
      "script[data-twikoo]:not([data-ok]):not([data-fail])"
    );
    if (pending) {
      pending.addEventListener("load", () => {
        pending.dataset.ok = "1";
        onReady();
      });
      pending.addEventListener("error", onFail);
      return;
    }

    // 逐 CDN 尝试
    const tryNext = (i: number) => {
      if (i >= CDN_LIST.length) {
        onFail();
        return;
      }
      const s = document.createElement("script");
      s.src = CDN_LIST[i];
      s.async = true;
      s.dataset.twikoo = "1";
      s.addEventListener("load", () => {
        s.dataset.ok = "1";
        onReady();
      });
      s.addEventListener("error", () => {
        s.dataset.fail = "1";
        tryNext(i + 1);
      });
      document.head.appendChild(s);
    };
    tryNext(0);
  }

  function refreshColors() {
    // Twikoo 通过 CSS 变量控制配色，这里直接映射到站点主题
    const html = document.documentElement;
    const fg = getComputedStyle(html).getPropertyValue("--foreground").trim();
    const bg = getComputedStyle(html).getPropertyValue("--background").trim();
    const accent = getComputedStyle(html).getPropertyValue("--accent").trim();
    const border = getComputedStyle(html).getPropertyValue("--border").trim();

    if (fg) html.style.setProperty("--tk-color-foreground", fg);
    if (bg) html.style.setProperty("--tk-color-background", bg);
    if (accent) html.style.setProperty("--tk-color-accent", accent);
    if (border) html.style.setProperty("--tk-color-border", border);
  }

  function initSection() {
    if (!document.getElementById("twikoo-comment")) return;

    const section = document.querySelector(".twikoo-section");
    const envId = section?.getAttribute("data-env-id") || "";
    if (!envId) {
      const loading = document.querySelector("[data-tk-loading]");
      if (loading) loading.textContent = "评论区未配置";
      return;
    }

    const showError = () => {
      const loading = document.querySelector("[data-tk-loading]");
      if (loading) {
        loading.textContent = "评论区加载失败，请稍后重试";
        loading.classList.add("tk-loading--error");
      }
    };

    // 用「当前的挂载点 / 当前的 path」初始化（View Transitions 切页后仍是当前页），
    // 避免异步回调捕获旧页元素导致错挂
    loadTwikooScript(
      () => {
        const mount = document.getElementById("twikoo-comment");
        if (!mount || mount.dataset.tkInited === "1") return;
        mount.dataset.tkInited = "1";
        document.querySelector("[data-tk-loading]")?.remove();
        refreshColors();
        (window as any).Twikoo.init({
          el: "#twikoo-comment",
          envId,
          serverURL: envId,
          path: location.pathname,
          nick: "",
          avatar: "",
          region: "",
          language: "zh-CN",
          emojiUrl: "https://gw.alicdn.com/seed",
          onInit: () => refreshColors(),
        } as any);
      },
      showError
    );
  }

  document.addEventListener("astro:page-load", () => {
    initSection();
    refreshColors();
  });

  // 主题切换时同步配色
  window.addEventListener("storage", e => {
    if (e.key === "theme") refreshColors();
  });

  // 暴露给外部（供主题切换器触发）
  (window as any).__refreshTwikooColors = refreshColors;
</script>

<style>
  /* ═══ 评论区容器 ═══ */
  .twikoo-container {
    margin-top: 1.25rem;
    padding: 1.5rem;
    border-radius: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--border) 25%, transparent);
    background: color-mix(in srgb, var(--foreground) 3%, var(--background));
    max-height: 70vh;
    overflow-y: auto;
  }
  .twikoo-container::-webkit-scrollbar {
    width: 6px;
  }
  .twikoo-container::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--accent) 20%, transparent);
    border-radius: 10px;
  }

  .tk-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 2rem 1rem;
    color: color-mix(in srgb, var(--foreground) 55%, transparent);
    font-size: 0.85rem;
  }
  .tk-loading--error {
    color: #ef4444;
  }
  .tk-loading-ring {
    width: 1rem;
    height: 1rem;
    border: 2px solid color-mix(in srgb, var(--accent) 20%, transparent);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: tk-spin 0.7s linear infinite;
  }
  @keyframes tk-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ═══ Twikoo 主题美化 ═══ */
  /* 整体文字色 */
  .tk-mount,
  .tk-mount * {
    font-family: inherit;
  }
  .tk-mount {
    color: color-mix(in srgb, var(--foreground) 80%, transparent);
  }
  /* 评论条 */
  .tk-mount .tk-comment {
    padding: 0.85rem 0.9rem;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--border) 18%, transparent);
    background: color-mix(in srgb, var(--foreground) 3%, transparent);
    margin-bottom: 0.6rem;
    transition: border-color 0.2s ease;
  }
  .tk-mount .tk-comment:hover {
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
  }
  /* 头像 */
  .tk-mount .tk-comment-avatar,
  .tk-mount .tk-avatar-wrap img {
    border-radius: 50% !important;
    border: 1.5px solid color-mix(in srgb, var(--border) 40%, transparent) !important;
  }
  /* 作者名与时间 */
  .tk-mount .tk-comment-author,
  .tk-mount .tk-comment-meta .tk-author {
    color: var(--foreground) !important;
    font-weight: 600;
  }
  .tk-mount .tk-comment-date,
  .tk-mount .tk-comment-meta .tk-time,
  .tk-mount .tk-comment-meta {
    color: color-mix(in srgb, var(--foreground) 45%, transparent) !important;
    font-size: 0.75rem;
  }
  /* 评论内容 */
  .tk-mount .tk-comment-content {
    color: color-mix(in srgb, var(--foreground) 88%, transparent) !important;
  }
  .tk-mount .tk-comment-content a,
  .tk-mount .tk-comment-link {
    color: var(--accent) !important;
    text-decoration: none;
    border-bottom: 1px dashed color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .tk-mount .tk-comment-content a:hover {
    border-bottom-style: solid;
  }
  /* 代码块 */
  .tk-mount .tk-comment-content pre {
    background: color-mix(in srgb, var(--foreground) 6%, transparent) !important;
    border: 1px solid color-mix(in srgb, var(--border) 30%, transparent);
    border-radius: 0.6rem;
    padding: 0.75rem;
  }
  .tk-mount .tk-comment-content code {
    font-family: var(--font-firacode), monospace;
    font-size: 0.85em;
  }
  /* 编辑器 */
  .tk-mount .tk-editor {
    background: color-mix(in srgb, var(--foreground) 3%, transparent) !important;
    border: 1px solid color-mix(in srgb, var(--border) 30%, transparent) !important;
    border-radius: 0.85rem !important;
    overflow: hidden;
  }
  .tk-mount .tk-editor:focus-within {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent) !important;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .tk-mount .tk-editor-content {
    background: transparent !important;
    color: var(--foreground) !important;
    min-height: 5rem;
  }
  .tk-mount .tk-editor-content::placeholder {
    color: color-mix(in srgb, var(--foreground) 40%, transparent);
  }
  /* 提交按钮 */
  .tk-mount .tk-submit-btn {
    background: var(--accent) !important;
    color: #fff !important;
    border: none !important;
    border-radius: 999px !important;
    padding: 0.45rem 1.1rem !important;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.2s ease;
  }
  .tk-mount .tk-submit-btn:hover {
    box-shadow: 0 4px 14px color-mix(in srgb, var(--accent) 35%, transparent);
    transform: translateY(-1px);
  }
  .tk-mount .tk-submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }
  /* 头像框 */
  .tk-mount .tk-avatar-wrap {
    background: color-mix(in srgb, var(--foreground) 5%, transparent) !important;
    border: 1px solid color-mix(in srgb, var(--border) 30%, transparent) !important;
    border-radius: 50% !important;
  }
  /* 标签页 */
  .tk-mount .tk-tab-group {
    border-bottom-color: color-mix(in srgb, var(--border) 30%, transparent) !important;
  }
  .tk-mount .tk-tab {
    color: color-mix(in srgb, var(--foreground) 55%, transparent) !important;
  }
  .tk-mount .tk-tab.active,
  .tk-mount .tk-tab:hover {
    color: var(--accent) !important;
  }
  .tk-mount .tk-tab.active {
    border-bottom-color: var(--accent) !important;
  }
  /* 分页 */
  .tk-mount .tk-paginator {
    border-color: color-mix(in srgb, var(--border) 30%, transparent) !important;
  }
  .tk-mount .tk-paginator-page {
    color: var(--foreground) !important;
  }
  .tk-mount .tk-paginator-page.active,
  .tk-mount .tk-paginator-page:hover {
    background: color-mix(in srgb, var(--accent) 15%, transparent) !important;
    color: var(--accent) !important;
  }
  /* 空状态 */
  .tk-mount .tk-no-comment,
  .tk-mount .tk-tip-empty {
    color: color-mix(in srgb, var(--foreground) 45%, transparent) !important;
    padding: 2rem 0;
  }
  /* 引用回复 */
  .tk-mount .tk-comment-son,
  .tk-mount .tk-comment-son .tk-comment {
    border-color: color-mix(in srgb, var(--border) 18%, transparent);
  }
  /* 表情选择器 */
  .tk-mount .tk-emoji {
    background: color-mix(in srgb, var(--foreground) 5%, transparent) !important;
    border-color: color-mix(in srgb, var(--border) 30%, transparent) !important;
  }
  .tk-mount .tk-editor-tools {
    border-top-color: color-mix(in srgb, var(--border) 30%, transparent) !important;
    background: color-mix(in srgb, var(--foreground) 2%, transparent) !important;
  }
  /* 移动端 */
  @media (max-width: 640px) {
    .twikoo-container {
      padding: 1rem;
      max-height: 60vh;
    }
    .tk-mount .tk-comment {
      padding: 0.7rem 0.75rem;
    }
  }
</style>
