---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { SITE } from "@/config";

const title = "友圈 | " + SITE.title;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  url: new URL("/links/fcircle/", SITE.website).toString(),
  description: "Friend Circle — aggregated feed of friends' latest posts.",
  isPartOf: { "@type": "WebSite", name: SITE.title, url: SITE.website },
};
---

<Layout title={title} description="友圈 — 聚合友链站点的最新文章" structuredData={structuredData}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-12">
    <!-- Hero -->
    <div class="archive-hero" data-archive-hero>
      <div class="aurora-orb aurora-orb-1"></div>
      <div class="aurora-orb aurora-orb-2"></div>
      <div class="aurora-orb aurora-orb-3"></div>
      <div class="aurora-mouse" data-archive-mouse></div>
      <div class="relative z-10">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
          <span class="glow-text">Friend Circle</span>
        </h1>
        <p class="mt-3 max-w-lg text-foreground/70 italic">
          聚合友链站点的最新动态。
        </p>
      </div>
    </div>

    <!-- ═══ 友圈（Friend-Circle-Lite）═══ -->
    <div class="fcircle-wrap">
      <section class="feed-section">
        <div id="friend-circle-lite-root"></div>
      </section>
      <section class="status-section">
        <div class="status-head">
          <h2 class="status-title">友链状态</h2>
          <span id="links-summary" class="status-summary">加载中…</span>
        </div>
        <div id="links-grid" class="status-grid"></div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<!-- 插件样式 -->
<link rel="stylesheet" href="/fcircle/fcircle.css" />

<style is:global>
  /* ── 与站点对齐：宽度、间距、hero 与插件的衔接 ── */
  .fcircle-wrap {
    margin-top: 1.5rem;
    max-width: 72rem;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
  }

  /* feed-section 与站点正文宽度一致 */
  .fcircle-wrap .feed-section {
    margin-bottom: 2rem;
  }

  /* 插件容器：让随机文章卡与统计栏在窄屏不错位 */
  .fcircle-wrap #friend-circle-lite-root {
    max-width: 100%;
    min-width: 0;
    overflow-x: clip;
  }

  /* 状态区：与文章卡片、侧边栏一致的玻璃质感 */
  .fcircle-wrap .status-section {
    border-radius: 1.25rem;
  }

  /* 移动端：插件卡片单列 + 溢出修复 */
  @media (max-width: 768px) {
    .fcircle-wrap {
      max-width: 100%;
      overflow-x: clip;
    }
    .fcircle-wrap #friend-circle-lite-root {
      max-width: 100%;
      min-width: 0;
      overflow-x: clip;
    }
    .fcircle-wrap .status-section {
      max-width: 100%;
    }
  }
</style>

<!-- 插件脚本：自包含、幂等（内部有 __fcircleReady 守卫）。
     is:inline 防止 Astro 把它当作模块打包改写。 -->
<script is:inline src="/fcircle/fcircle.js"></script>
