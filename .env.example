# ─────────────────────────────────────────────────────────────────────────────
# 茗辰原 · Devosfera — 环境变量
# 复制本文件为 .env 并填入你自己的值。.env 已被 gitignore，切勿提交个人数据。
# ─────────────────────────────────────────────────────────────────────────────

# ── 社交链接（侧栏 / 页脚）─────────────────────────────────────────────────
# 留空则隐藏对应链接。
PUBLIC_SOCIAL_GITHUB=https://github.com/rumian0
PUBLIC_SOCIAL_X=https://x.com/mingcy070329
# PUBLIC_SOCIAL_LINKEDIN=
PUBLIC_SOCIAL_EMAIL=mcy@mingcy.cn

# ── "编辑此文" 按钮 ─────────────────────────────────────────────────────────
# 仓库编辑页前缀，文章路径会自动拼接在后。
PUBLIC_EDIT_POST_URL=https://github.com/rumian0/astro/edit/main/

# ── Google Search Console 验证（可选）──────────────────────────────────────
# PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── AI 摘要生成（构建期，仅服务端）──────────────────────────────────────────
# gen-ai-summaries.mjs 调用的 EdgeOne AI Chat 接口（SSE 流式）。
# 构建时通过 node scripts/gen-ai-summaries.mjs 读取，不进入客户端 bundle。
AI_CHAT_URL=https://ai.mingcy.cn/chat
