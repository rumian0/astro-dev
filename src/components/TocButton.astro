---
/**
 * TocButton — 文章目录（右下角浮动按钮 + 弹出树形面板）
 *
 * 服务端：通过 astro:content render() 返回的 headings 构建标题树
 * 客户端：仅处理弹窗开关、滚动高亮、平滑滚动
 *
 * 布局：位于 btt-btn-container（返回顶部按钮）正上方，尺寸一致
 * 面板：弹窗形式，底部追加固定「评论」导航项 → #comments
 */
interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const { headings } = Astro.props;

// ── 构建树形结构 ──
type TocNode = {
  depth: number;
  slug: string;
  text: string;
  children: TocNode[];
};

const tree: TocNode[] = [];
const stack: TocNode[] = [];
for (const h of headings) {
  const node: TocNode = { ...h, children: [] };
  while (stack.length && stack[stack.length - 1].depth >= h.depth) {
    stack.pop();
  }
  if (stack.length) stack[stack.length - 1].children.push(node);
  else tree.push(node);
  stack.push(node);
}

// ── 递归渲染 HTML ──
// 缩进公式：(depth - 2) * 16px
// h2=0, h3=16, h4=32, h5=48
function renderTree(nodes: TocNode[]): string {
  return nodes
    .map((n) => {
      const indent = Math.max(0, (n.depth - 2) * 16);
      const dotClass = n.depth <= 2 ? "solid" : "hollow";
      const childrenHtml = n.children.length
        ? `<div class="toc-children">${renderTree(n.children)}</div>`
        : "";
      return `<div class="toc-node" style="padding-left:${indent}px" data-depth="${n.depth}">
        <div class="toc-row">
          <span class="toc-dot ${dotClass}" aria-hidden="true"></span>
          <a href="#${n.slug}" class="toc-link" data-slug="${n.slug}">${n.text}</a>
        </div>${childrenHtml}
      </div>`;
    })
    .join("");
}

const treeHtml = renderTree(tree);


---

    <div
      id="toc-fab-container"
      data-open="false"
      class="pointer-events-none fixed end-4 bottom-24 z-50 md:end-8 md:bottom-28"
    >
      <button
        id="toc-fab"
        type="button"
        aria-label="打开目录"
        aria-expanded="false"
        title="目录"
        class:list={[
          "pointer-events-auto group relative flex flex-col items-center justify-center",
          "size-14 rounded-full",
          "md:size-16",
          "border border-accent/15 bg-background/75 backdrop-blur-md",
          "shadow-[0_4px_20px_rgba(0,0,0,0.20)] dark:shadow-[0_4px_20px_rgba(0,0,0,0.60)]",
          "hover:shadow-[0_6px_28px_rgba(0,0,0,0.30)] dark:hover:shadow-[0_6px_28px_rgba(0,0,0,0.75)]",
          "hover:scale-105 active:scale-95 motion-reduce:hover:scale-100 motion-reduce:active:scale-100",
          "transition-all duration-200 ease-out motion-reduce:transition-none",
          "text-foreground/70 hover:text-accent",
        ]}
      >
        <svg
          class="size-5 md:size-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="14" y2="12"></line>
          <line x1="4" y1="18" x2="10" y2="18"></line>
        </svg>
        <span class="text-[8px] font-medium tracking-wider uppercase opacity-0 transition-opacity duration-200 group-hover:opacity-70">
          TOC
        </span>
      </button>

      <!-- ═══ 弹出面板 ═══ -->
      <div
        id="toc-panel"
        class="pointer-events-auto absolute bottom-full mb-3 end-0 flex flex-col overflow-hidden rounded-2xl border border-border/30 bg-background/85 shadow-2xl backdrop-blur-xl"
        style="width: min(72vw, 18rem); max-height: min(60vh, 28rem);"
        role="dialog"
        aria-label="文章目录"
      >
        <!-- 面板头部 -->
        <div class="flex items-center justify-between px-4 py-2.5 border-b border-border/20 shrink-0">
          <span class="text-sm font-semibold tracking-wide text-foreground flex items-center gap-1.5">
            <span class="size-1.5 rounded-full bg-accent shadow-[0_0_6px_var(--color-accent)]"></span>
            目录
          </span>
          <button
            id="toc-close"
            type="button"
            aria-label="关闭目录"
            class="grid place-items-center size-6 rounded-full text-foreground/50 hover:text-accent hover:bg-accent/10 transition-colors"
          >
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <!-- 面板内容 -->
        <nav class="overflow-y-auto p-2.5 pb-3" id="toc-list">
          <!-- 树形列表（服务端渲染） -->
          <div set:html={treeHtml}></div>

          <!-- 分割线 -->
          <div class="mx-3 my-2 h-px bg-border/20"></div>

          <!-- 固定「评论」导航项 -->
          <a
            href="#comments"
            class="toc-row toc-comment-item"
            data-toc-comment
          >
            <span class="toc-dot hollow" aria-hidden="true"></span>
            <span class="text-foreground/70 text-sm hover:text-accent transition-colors">
              💬 评论
            </span>
          </a>
        </nav>
      </div>
    </div>

    <style>
      /* ═══ 树形条目样式 ═══ */

      /* 条目行 */
      .toc-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.3rem 0.55rem;
        border-radius: 0.5rem;
        border-left: 2px solid transparent;
        transition:
          background-color 0.22s ease-out,
          border-color 0.22s ease-out;
        cursor: pointer;
      }
      .toc-row:hover {
        background: color-mix(in srgb, var(--color-accent) 7%, transparent);
      }

      /* 圆点标记 */
      .toc-dot {
        flex-shrink: 0;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 9999px;
        transition:
          transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1),
          background-color 0.22s ease-out,
          border-color 0.22s ease-out;
      }
      .toc-dot.solid {
        background: var(--color-accent);
        box-shadow: 0 0 6px color-mix(in srgb, var(--color-accent) 50%, transparent);
      }
      .toc-dot.hollow {
        border: 2px solid var(--color-accent);
        background: transparent;
      }

      /* 标题链接 */
      .toc-link {
        flex: 1;
        min-width: 0;
        text-decoration: none;
        color: color-mix(in srgb, var(--color-foreground) 72%, transparent);
        font-size: 0.8rem;
        line-height: 1.4;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: color 0.22s ease-out;
      }
      .toc-link:hover {
        color: var(--color-accent);
      }

      /* 层级字号与字重 */
      .toc-node[data-depth="2"] > .toc-row .toc-link {
        font-size: 0.82rem;
        font-weight: 650;
        color: var(--color-foreground);
      }
      .toc-node[data-depth="3"] > .toc-row .toc-link {
        font-size: 0.76rem;
        font-weight: 500;
      }
      .toc-node[data-depth="4"] > .toc-row .toc-link,
      .toc-node[data-depth="5"] > .toc-row .toc-link {
        font-size: 0.72rem;
        font-weight: 400;
        color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
      }

      /* 子列表：垂直引导线 + 缩进 */
      .toc-children {
        margin-left: 7px;
        padding-left: 16px;
        border-left: 1px solid color-mix(in srgb, var(--color-border) 45%, transparent);
      }

      /* 激活态：整行高亮 + 文字加粗 */
      .toc-row.is-active {
        background: color-mix(in srgb, var(--color-accent) 12%, transparent);
        border-left-color: var(--color-accent);
      }
      .toc-row.is-active .toc-link {
        color: var(--color-accent);
        font-weight: 600;
      }
      .toc-row.is-active .toc-dot {
        transform: scale(1.25);
        box-shadow: 0 0 8px color-mix(in srgb, var(--color-accent) 70%, transparent);
      }
      .toc-row.is-active .toc-dot.hollow {
        background: var(--color-accent);
        border-color: var(--color-accent);
      }

      /* 祖先链路弱化 */
      .toc-node.is-ancestor > .toc-row .toc-link {
        color: color-mix(in srgb, var(--color-foreground) 50%, transparent);
      }

      /* 评论条目 */
      .toc-comment-item {
        font-size: 0.8rem;
      }

      /* 滚动条 */
      #toc-list {
        scrollbar-width: thin;
        scrollbar-color: color-mix(in srgb, var(--color-accent) 30%, transparent) transparent;
      }
      #toc-list::-webkit-scrollbar {
        width: 4px;
      }
      #toc-list::-webkit-scrollbar-thumb {
        background: color-mix(in srgb, var(--color-accent) 28%, transparent);
        border-radius: 10px;
      }

      /* ═══ 面板显隐：可反转的打开 / 关闭过渡（只动 opacity + transform）═══ */
      #toc-panel {
        opacity: 0;
        transform: translateY(0.5rem) scale(0.96);
        transform-origin: bottom right;
        pointer-events: none;
        visibility: hidden;
        transition:
          opacity 0.18s ease-out,
          transform 0.24s cubic-bezier(0.34, 1.4, 0.5, 1),
          visibility 0s linear 0.24s;
      }
      #toc-fab-container[data-open="true"] #toc-panel {
        opacity: 1;
        transform: translateY(0) scale(1);
        pointer-events: auto;
        visibility: visible;
        transition:
          opacity 0.18s ease-out,
          transform 0.24s cubic-bezier(0.34, 1.4, 0.5, 1),
          visibility 0s;
      }

      @media (prefers-reduced-motion: reduce) {
        #toc-panel,
        #toc-fab-container[data-open="true"] #toc-panel {
          transition: visibility 0s;
        }
        .toc-row,
        .toc-dot,
        .toc-link {
          transition: none;
        }
      }

      /* 移动端面板宽度 */
      @media (max-width: 640px) {
        #toc-panel {
          max-height: 52vh;
        }
      }
    </style>

    <script>
      // ═══ 客户端交互：弹窗开关、滚动高亮、平滑滚动 ═══
      let tocCleanup: AbortController | null = null;

      document.addEventListener("astro:page-load", () => {
        if (tocCleanup) tocCleanup.abort();
        tocCleanup = new AbortController();
        const { signal } = tocCleanup;

        const fab = document.getElementById("toc-fab");
        const fabContainer = document.getElementById("toc-fab-container");
        const list = document.getElementById("toc-list");
        const closeBtn = document.getElementById("toc-close");
        if (!fab || !fabContainer || !list) return;

        // 滚动高亮刷新钩子（无标题时保持 no-op）
        let refreshHighlight: () => void = () => {};

        const isOpen = () => fabContainer.getAttribute("data-open") === "true";
        const open = () => {
          fabContainer.setAttribute("data-open", "true");
          fab.setAttribute("aria-expanded", "true");
          fab.setAttribute("aria-label", "关闭目录");
          refreshHighlight();
        };
        const close = () => {
          fabContainer.setAttribute("data-open", "false");
          fab.setAttribute("aria-expanded", "false");
          fab.setAttribute("aria-label", "打开目录");
        };

        // 浮动按钮开关
        fab.addEventListener(
          "click",
          (e) => {
            e.stopPropagation();
            isOpen() ? close() : open();
          },
          { signal }
        );
        closeBtn?.addEventListener("click", close, { signal });

        // 点击面板外部关闭
        document.addEventListener(
          "click",
          (e) => {
            if (isOpen() && !fabContainer.contains(e.target as Node)) close();
          },
          { signal }
        );

        // ESC 关闭
        document.addEventListener(
          "keydown",
          (e) => {
            if (e.key === "Escape" && isOpen()) close();
          },
          { signal }
        );

        // 点击目录项：平滑滚动 + 关闭面板
        list.addEventListener(
          "click",
          (e) => {
            const target = e.target as HTMLElement;
            const commentLink = target.closest("[data-toc-comment]");
            const tocLink = target.closest<HTMLElement>("[data-slug]");

            let id: string | null = null;
            if (commentLink) {
              id = "comments";
            } else if (tocLink) {
              id = tocLink.getAttribute("data-slug");
            }
            if (!id) return;

            e.preventDefault();
            const el = document.getElementById(id);
            if (el) {
              el.scrollIntoView({ behavior: "smooth", block: "start" });
              history.replaceState(null, "", `#${id}`);
            }
            close();
          },
          { signal }
        );

        // ── 滚动高亮 + 自动展开祖先 ──
        // 每个条目预缓存「对应行 / 严格祖先 toc-node / 文档内绝对 top」，
        // 滚动时只做常量级类名切换，不再反复 querySelector / closest
        type TocItem = {
          id: string;
          heading: HTMLElement;
          row: HTMLElement;
          ancestors: HTMLElement[];
          top: number;
        };
        const items: TocItem[] = [];
        list.querySelectorAll<HTMLElement>("[data-slug]").forEach((link) => {
          const id = link.getAttribute("data-slug");
          const heading = id ? document.getElementById(id) : null;
          const row = link.closest<HTMLElement>(".toc-row");
          if (!id || !heading || !row) return;

          // 收集严格祖先的 .toc-node（跳过自身所在的那一层）
          const ancestors: HTMLElement[] = [];
          let own = false;
          let el = row.parentElement;
          while (el && el !== list) {
            if (el.classList.contains("toc-node")) {
              if (own) ancestors.push(el);
              else own = true;
            }
            el = el.parentElement;
          }
          items.push({ id, heading, row, ancestors, top: 0 });
        });

        if (items.length) {
          // 探测线：视口顶部往下 18%，标题越过此线即算当前章节
          const PROBE_RATIO = 0.18;
          let rafId = 0;
          let active: TocItem | null = null;

          const measure = () => {
            items.forEach((it) => {
              it.top = it.heading.getBoundingClientRect().top + window.scrollY;
            });
            items.sort((a, b) => a.top - b.top);
          };

          const activate = (it: TocItem) => {
            if (active && active !== it) {
              active.row.classList.remove("is-active");
              active.ancestors.forEach((n) => n.classList.remove("is-ancestor"));
            }
            it.row.classList.add("is-active");
            it.ancestors.forEach((n) => n.classList.add("is-ancestor"));
            active = it;
          };

          const scheduleUpdate = () => {
            if (rafId) return;
            rafId = requestAnimationFrame(() => {
              rafId = 0;
              const probe = window.scrollY + window.innerHeight * PROBE_RATIO;
              let current = items[0];
              for (const it of items) {
                if (it.top <= probe) current = it;
                else break;
              }
              // 滚到底部固定最后一节
              if (
                window.innerHeight + window.scrollY >=
                document.documentElement.scrollHeight - 2
              ) {
                current = items[items.length - 1];
              }
              if (current !== active) activate(current);
            });
          };

          let resizeRaf = 0;
          const reMeasure = () => {
            if (resizeRaf) return;
            resizeRaf = requestAnimationFrame(() => {
              resizeRaf = 0;
              measure();
              scheduleUpdate();
            });
          };

          refreshHighlight = () => {
            measure();
            scheduleUpdate();
          };

          measure();
          scheduleUpdate();

          // 滚动 / 尺寸变化 / 字体与图片加载导致布局重排时都要跟上
          window.addEventListener("scroll", scheduleUpdate, {
            passive: true,
            signal,
          });
          window.addEventListener("resize", reMeasure, {
            passive: true,
            signal,
          });
          if (document.fonts) {
            document.fonts.ready.then(reMeasure).catch(() => {});
          }
          document
            .getElementById("main-content")
            ?.querySelectorAll("img")
            .forEach((img) => {
              if (!img.complete) {
                img.addEventListener("load", reMeasure, { signal, once: true });
              }
            });
        }
      });
    </script>

